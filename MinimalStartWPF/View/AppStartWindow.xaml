<base:WindowBase
    x:Class="MinimalWPF.View.AppStartWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MinimalWPF.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding Path=WindowTitel, FallbackValue=~WindowTitel}"
    Width="800"
    Height="460"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid
        x:Name="gridMain"
        Background="WhiteSmoke"
        ColumnDefinitions="*,400,5"
        RowDefinitions="Auto,*,*,*,*,60">

        <!--  Inhalte zum Window  -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="6"
            Grid.Column="0"
            Margin="0,0,10,0"
            BorderBrush="Black"
            BorderThickness="0,0,1,0">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="32"
                FontWeight="Bold"
                Text="Bereich für Bild" />
        </Border>

        <Border
            Grid.Row="0"
            Grid.Column="1"
            BorderBrush="Red"
            BorderThickness="0,0,0,3">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    FontSize="18"
                    FontWeight="Bold"
                    Text="Applikations Name" />

                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Text="Short Description" />
            </StackPanel>
        </Border>

        <GroupBox
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,10,0,0"
            BorderBrush="Gray"
            Header="Benutzerinformationen">
            <TextBlock Text="Content" />
        </GroupBox>

        <GroupBox
            Grid.Row="2"
            Grid.Column="1"
            Margin="0,10,0,0"
            BorderBrush="Gray"
            Header="Softwareinformation">
            <TextBlock Text="Content" />
        </GroupBox>

        <GroupBox
            Grid.Row="3"
            Grid.Column="1"
            Margin="0,10,0,0"
            BorderBrush="Gray"
            Header="Datenbankinformation">
            <TextBlock Text="Content" />
        </GroupBox>

        <GroupBox
            Grid.Row="4"
            Grid.Column="1"
            Margin="0,10,0,0"
            BorderBrush="Gray"
            Header="Zugriffsart">
            <TextBlock Text="Content" />
        </GroupBox>

        <Border
            Grid.Row="5"
            Grid.RowSpan="3"
            Grid.Column="1">
            <StackPanel Orientation="Horizontal">
                <Button
                    Width="100"
                    Height="35"
                    Command="{Binding Path=QuitCommand}"
                    CommandParameter="START"
                    Content="Start">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Label Width="190" />
                <Button
                    Width="100"
                    Height="35"
                    Command="{Binding Path=QuitCommand}"
                    CommandParameter="EXIT"
                    Content="Beenden">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</base:WindowBase>
