    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TreeView
            x:Name="TreeView"
            ItemContainerStyle="{Binding ElementName=pickerControl, Path=ItemContainerStyle}"
            ItemsSource="{Binding ElementName=pickerControl, Path=Root.Childs}"
            TreeViewItem.Expanded="TreeView_Expanded"
            TreeViewItem.Selected="TreeView_Selected">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Childs}">
                    <StackPanel ContextMenu="{StaticResource TreeItemContextMenu}" Orientation="Horizontal">
                        <Image
                            Width="18"
                            Height="18"
                            Source="{Binding Converter={StaticResource ResourceKey=DriveIconConverter}, ConverterParameter={x:Reference pickerControl}}" />
                        <TextBlock
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding Path=Name}" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
