<base:UserControlBase
    x:Class="MinimalWPF.Beispiele.DialogServiceUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:beispiel="clr-namespace:MinimalWPF.Beispiele"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MinimalWPF.Beispiele"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="490"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid
        x:Name="gridMain"
        Background="WhiteSmoke"
        ColumnDefinitions="*"
        RowDefinitions="Auto,Auto,*">

        <!--#region Dialog Menütoolbar-->
        <GroupBox
            x:Name="MainMenubar"
            Grid.Row="0"
            Margin="5"
            Padding="5">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>
            <DockPanel Grid.Row="0" Grid.Column="0">
                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=GoBackCommand}"
                    CommandParameter="{x:Static beispiel:CommandButtons.GoBack}"
                    ToolTip="Zurück">
                    <Image Source="{StaticResource ResourceKey=IconGoBack}" Stretch="Uniform" />
                </Button>

            </DockPanel>
        </GroupBox>

        <!--#endregion Dialog Menütoolbar-->

        <GroupBox
            Grid.Row="1"
            Padding="10"
            BorderBrush="Gray">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="Blue"
                        Text="Erklärung" />
                </StackPanel>
            </GroupBox.Header>

            <TextBlock FontSize="13" TextWrapping="Wrap">
                <Run Text="Bei der Klasse " />
                <Run
                    Background="LightGray"
                    Foreground="Black"
                    Text="DialogService" />
                <Run Text="handelt es sich um eine Klasse, die den Aufruf von Dialogen in einer WPF-Anwendung vereinfacht." />
                <Run Text="Das Beispiel zeigt die Verwendung der Klasse in einem WPF Projekt. Es ist eine einfache Anwendung, die die Funktionalität des DialogService und der Klasse DialogResponse demonstriert." />
                <LineBreak />
                <Run Text="In der" />
                <Run
                    Background="LightGray"
                    Foreground="Black"
                    Text="DialogResponse&lt;TWindow&gt;" />
                <Run Text="Klasse werden die Informationen über den Dialog zurückgegeben, einschließlich des Dialogergebnisses und der Instanz des Dialogs." />
            </TextBlock>
        </GroupBox>

        <GroupBox
            Grid.Row="2"
            Margin="0,10,0,0"
            Padding="10"
            BorderBrush="Gray">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="Blue"
                        Text="Beispiel" />
                </StackPanel>
            </GroupBox.Header>
            <!--  Inhalt der GroupBox  -->
            <StackPanel VerticalAlignment="Top" Orientation="Vertical">
                <Button
                    Height="30"
                    Command="{Binding Path=DialogServiceCommand}"
                    CommandParameter="1"
                    Content="Variante 1; Einfacher Aufruf eines Dialogs" />

                <Button
                    Height="30"
                    Margin="0,5,0,0"
                    Command="{Binding Path=DialogServiceCommand}"
                    CommandParameter="2"
                    Content="Variante 2; Aufruf mit Fluent-API" />

                <Button
                    Height="30"
                    Margin="0,5,0,0"
                    Command="{Binding Path=DialogServiceCommand}"
                    CommandParameter="3"
                    Content="Variante 3; Aufruf mit Konstruktor Parameter" />

                <Button
                    Height="30"
                    Margin="0,5,0,0"
                    Command="{Binding Path=DialogServiceCommand}"
                    CommandParameter="3"
                    Content="Variante 4; Aufruf mit Animation" />

                <Button
                    Height="30"
                    Margin="0,5,0,0"
                    Command="{Binding Path=DialogServiceCommand}"
                    CommandParameter="5"
                    Content="Variante 5; Aufruf mit Show() (nicht Modal)" />

                <Button
                    Height="30"
                    Margin="0,5,0,0"
                    Command="{Binding Path=DialogServiceCommand}"
                    CommandParameter="6"
                    Content="Variante 6; Aufruf mit Konfiguration (.Show()/.ShowDialog())" />

                <Button
                    Height="30"
                    Margin="0,5,0,0"
                    Command="{Binding Path=DialogServiceCommand}"
                    CommandParameter="7"
                    Content="Variante 7; Custom static Dialog" />
            </StackPanel>
        </GroupBox>
    </Grid>
</base:UserControlBase>
