<base:UserControlBase
    x:Class="MinimalWPF.Beispiel.LocalizationUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:beispiel="clr-namespace:MinimalWPF.Beispiele"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MinimalWPF.Beispiel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid
        x:Name="gridMain"
        Background="WhiteSmoke"
        ColumnDefinitions="*"
        RowDefinitions="Auto,Auto,*">

        <!--#region Hauptmenübar-->
        <GroupBox
            x:Name="MainMenubar"
            Grid.Row="0"
            Margin="5"
            Padding="5">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>
            <DockPanel Grid.Row="0" Grid.Column="0">
                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=GoBackCommand}"
                    CommandParameter="{x:Static beispiel:CommandButtons.GoBack}"
                    ToolTip="Zurück">
                    <Image Source="{StaticResource ResourceKey=IconGoBack}" Stretch="Uniform" />
                </Button>

            </DockPanel>
        </GroupBox>
        <!--#endregion Hauptmenübar-->

        <GroupBox
            Grid.Row="1"
            Padding="10"
            BorderBrush="Gray">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="Blue"
                        Text="Erklärung" />
                </StackPanel>
            </GroupBox.Header>

            <TextBlock FontSize="13" TextWrapping="Wrap">
                <Run Text="Die Lokalisierung ist recht einfach gestaltet. Die Texte zur Lokalisierung sind in einer Resources Datei 'Localization.xaml' abgelegt." />
                <LineBreak />
                <Run Text="Zum lesen von Lokalisierten Text stehen die Methoden" />
                <Run Background="LightGray" Text="LocalizationValue.Get(&quot;WindowsTitelZeile&quot;)" />
                <Run Text="und" />
                <Run
                    Background="LightGray"
                    Foreground="Black"
                    Text="LocalizationValue.Get&lt;T&gt;(&quot;EineZahl&quot;)" />
                <Run Text="zur Verfügung. So können verschiedene Werte zur Lokalisierung in einer Resource abgelegt werden " />
            </TextBlock>
        </GroupBox>

        <GroupBox
            Grid.Row="2"
            Padding="10"
            BorderBrush="Gray">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="Blue"
                        Text="Beispiel" />
                </StackPanel>
            </GroupBox.Header>

            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="Keys:" />

                    <ComboBox
                        x:Name="cbKeys"
                        Width="200"
                        Margin="10,0,0,0"
                        ItemsSource="{Binding Path=LocalizationKeys}"
                        SelectionChanged="cbKeys_SelectionChanged" />

                    <TextBlock
                        x:Name="TxtSelectedLocalizationValue"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding Path=SelectedLocalizationValue, FallbackValue=~SelectedLocalizationValue}" />
                </StackPanel>

            </StackPanel>

        </GroupBox>

    </Grid>
</base:UserControlBase>
