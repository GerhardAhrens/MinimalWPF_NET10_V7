<base:UserControlBase
    x:Class="MinimalWPF.Beispiele.SourceGenUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:beispiel="clr-namespace:MinimalWPF.Beispiele"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MinimalWPF.Beispiele"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid
        x:Name="gridMain"
        Background="WhiteSmoke"
        ColumnDefinitions="*"
        RowDefinitions="Auto,Auto,*">

        <!--#region Hauptmenübar-->
        <GroupBox
            x:Name="MainMenubar"
            Grid.Row="0"
            Margin="5"
            Padding="5">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>
            <DockPanel Grid.Row="0" Grid.Column="0">
                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=GoBackCommand}"
                    CommandParameter="{x:Static beispiel:CommandButtons.GoBack}"
                    ToolTip="Zurück">
                    <Image Source="{StaticResource ResourceKey=IconGoBack}" Stretch="Uniform" />
                </Button>

            </DockPanel>
        </GroupBox>

        <!--#endregion Hauptmenübar-->

        <GroupBox
            Grid.Row="1"
            Padding="10"
            BorderBrush="Gray">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="Blue"
                        Text="Erklärung" />
                </StackPanel>
            </GroupBox.Header>

            <TextBlock FontSize="13" TextWrapping="Wrap">
                <Run Text="Das Beispiel soll zeigen, wie aus Source Code der in den Resourcen abgelegt ist eine verwendbare Klasse als z.B UserControl erstellt werden kann." />
                <Run Text="Der erzeugte Source Code wird lokal unter ...\Template\&lt;Name&gt; gespeichert und kann per Zwischenablage (CTRL-V) an beliebiger Stelle eingefügt werden." />
            </TextBlock>
        </GroupBox>

        <GroupBox
            Grid.Row="2"
            Margin="0,10,0,0"
            Padding="10"
            BorderBrush="Gray">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="Blue"
                        Text="Beispiel" />
                </StackPanel>
            </GroupBox.Header>
            <!--  Inhalt der GroupBox  -->
            <StackPanel VerticalAlignment="Top" Orientation="Vertical">
                <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="Name der Klasse:" />
                    <TextBox
                        x:Name="txtClassName"
                        Width="200"
                        Height="20"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding Path=ClassName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Button
                    Height="30"
                    Command="{Binding Path=ShowSourceGenCommand}"
                    CommandParameter="Gen_1"
                    Content="Erstelle einer UserControl Klasse mit .xaml und .xaml.cs Datei" />

                <Button
                    Height="30"
                    Margin="0,5,0,0"
                    Command="{Binding Path=ShowSourceGenCommand}"
                    CommandParameter="Gen_2"
                    Content="Erstellt einer Window Klasse mit .xaml und .xaml.cs Datei" />

                <Button
                    Height="30"
                    Margin="0,5,0,0"
                    Command="{Binding Path=ShowSourceGenCommand}"
                    CommandParameter="Gen_3"
                    Content="Erstellen einer 'public Enum' -Klasse" />

                <Button
                    Height="30"
                    Margin="0,5,0,0"
                    Command="{Binding Path=ShowSourceGenCommand}"
                    CommandParameter="Gen_4"
                    Content="Erstellen einer 'public class'" />

                <Button
                    Height="30"
                    Margin="0,5,0,0"
                    Command="{Binding Path=ShowSourceGenCommand}"
                    CommandParameter="Gen_5"
                    Content="Erstellen einer 'public static class' für Extension (statische Typen)" />

                <Button
                    Height="30"
                    Margin="0,5,0,0"
                    Command="{Binding Path=ShowSourceGenCommand}"
                    CommandParameter="Gen_6"
                    Content="Erstellen einer 'public static class' für Extension" />
            </StackPanel>
        </GroupBox>
    </Grid>
</base:UserControlBase>
