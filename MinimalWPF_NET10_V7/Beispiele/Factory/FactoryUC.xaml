<base:UserControlBase
    x:Class="MinimalWPF.Beispiel.FactoryUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:beispiel="clr-namespace:MinimalWPF.Beispiele"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MinimalWPF.Beispiel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid
        x:Name="gridMain"
        Background="WhiteSmoke"
        ColumnDefinitions="*"
        RowDefinitions="Auto,Auto,*">

        <!--#region Hauptmenübar-->
        <GroupBox
            x:Name="MainMenubar"
            Grid.Row="0"
            Margin="5"
            Padding="5">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>
            <DockPanel Grid.Row="0" Grid.Column="0">
                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=GoBackCommand}"
                    CommandParameter="{x:Static beispiel:CommandButtons.GoBack}"
                    ToolTip="Zurück">
                    <Image Source="{StaticResource ResourceKey=IconGoBack}" Stretch="Uniform" />
                </Button>

            </DockPanel>
        </GroupBox>

        <!--#endregion Hauptmenübar-->

        <GroupBox
            Grid.Row="1"
            Padding="10"
            BorderBrush="Gray">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="Blue"
                        Text="Erklärung" />
                </StackPanel>
            </GroupBox.Header>

            <TextBlock FontSize="13" TextWrapping="Wrap">
                <Run Text="Das Factory Pattern ermöglicht über die" />
                <Run
                    Background="LightGray"
                    Foreground="Black"
                    Text="Get()" />
                <Run Text="-Methode die Erstellung von Klassen-Instanzen, entweder als Transient (neue Instanz bei jedem Aufruf) oder als Singleton (gleiche Instanz bei jedem Aufruf). Dadurch wird die Verwaltung von Abhängigkeiten und die Erstellung von Objekten in einer Anwendung erleichtert." />
                <LineBreak />
                <Run Text="Über die Factory können verschiedene Typen registriert und Instanzen zurückgegeben werden, ohne dass der Benutzer sich um die Details der Implementierung kümmern muss. Dies ermöglicht eine flexible und modulare Gestaltung der Anwendung." />
                <LineBreak />
                <Run Text="Auch können optionale Parameter bei der Erstellung von Instanzen verwendet werden, um die Flexibilität weiter zu erhöhen." />
                <LineBreak />
                <Run Text="Bevor ein Typ verwendet werden kann, muß dieser als" />
                <Run
                    Background="LightGray"
                    Foreground="Black"
                    Text="Factory.RegisterSingleton" />
                <Run Text="oder" />
                <Run
                    Background="LightGray"
                    Foreground="Black"
                    Text="Factory.RegisterTransient" />
                <Run Text="registriert werden" />
            </TextBlock>
        </GroupBox>

        <GroupBox
            Grid.Row="2"
            Padding="10"
            BorderBrush="Gray">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="Blue"
                        Text="Beispiel" />
                </StackPanel>
            </GroupBox.Header>

            <TextBlock FontSize="13" TextWrapping="Wrap">
                <Run Foreground="Green" Text="/* Typen registrieren */" />
                <LineBreak />
                <Run Foreground="Blue" Text="Factory.RegisterSingleton&lt;DialogView&gt;(DialogView.Home, () =&gt; new HelloUC()); " />
                <LineBreak />
                <LineBreak />
                <Run Foreground="Green" Text="/* Instanz zurückgeben */" />
                <LineBreak />
                <Run Foreground="Blue" Text="var home = Factory.GetInstance&lt;DialogView&gt;(DialogView.Home);" />
                " /></TextBlock>
        </GroupBox>

    </Grid>
</base:UserControlBase>
