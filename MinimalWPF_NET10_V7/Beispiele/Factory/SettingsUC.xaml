<base:UserControlBase
    x:Class="MinimalWPF.Beispiel.SettingsUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:beispiel="clr-namespace:MinimalWPF.Beispiele"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MinimalWPF.Beispiel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid
        x:Name="gridMain"
        Background="WhiteSmoke"
        ColumnDefinitions="*"
        RowDefinitions="Auto,Auto,*">

        <!--#region Hauptmenübar-->
        <GroupBox
            x:Name="MainMenubar"
            Grid.Row="0"
            Margin="5"
            Padding="5">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>
            <DockPanel Grid.Row="0" Grid.Column="0">
                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=GoBackCommand}"
                    CommandParameter="{x:Static beispiel:CommandButtons.GoBack}"
                    ToolTip="Zurück">
                    <Image Source="{StaticResource ResourceKey=IconGoBack}" Stretch="Uniform" />
                </Button>

            </DockPanel>
        </GroupBox>

        <!--#endregion Hauptmenübar-->

        <GroupBox
            Grid.Row="1"
            Padding="10"
            BorderBrush="Gray">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="Blue"
                        Text="Erklärung" />
                </StackPanel>
            </GroupBox.Header>

            <TextBlock FontSize="13" TextWrapping="Wrap">
                <Run Text="Die Funktionalität für die Verwaltung von Einstellungen für eine Applikation beruht auf der Klasse " />
                <Run
                    Background="LightGray"
                    Foreground="Black"
                    Text="SettingsBase" />
                <Run Text="als abstrakte Basis Klasse. Hierraus kann eine konkrete Klasse z.B." />
                <Run
                    Background="LightGray"
                    Foreground="Black"
                    Text="public sealed class ApplicationSettings : SettingsBase" />
                <Run Text="abgeleitet werden. Die Basisklasse beinhaltet alle Methoden zum Laden und Speichern von Änderungen an den Einstellungen." />
                <Run Text="Um die Einstellungen an einem möglichst frühen Zeitpunkt zur Verfügung zu haben werden diese in der App.cs ." />
                <Run
                    Background="LightGray"
                    Foreground="Black"
                    Text="App.cs" />
                <Run Text="über die Methode" />
                <Run
                    Background="LightGray"
                    Foreground="Black"
                    Text="OnStartup" />
                <Run Text="geladen und in einer statischen public Variabel gespeichert. Beim Programmende werden die Einstellungen mit der Methode" />
                <Run
                    Background="LightGray"
                    Foreground="Black"
                    Text="OnExit" />
                <Run Text="gespeichert. Natürlich können die Änderungen zu einem beliebigen anderen Zeitpunkt gespeichert werden." />
            </TextBlock>
        </GroupBox>

        <GroupBox
            Grid.Row="2"
            Padding="10"
            BorderBrush="Gray">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="Blue"
                        Text="Beispiel" />
                </StackPanel>
            </GroupBox.Header>
            <Grid
                VerticalAlignment="Top"
                ColumnDefinitions="150,150,*"
                RowDefinitions="Auto,Auto,Auto,auto,auto,auto,auto">
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Height="20"
                    HorizontalAlignment="Left"
                    Text="Einstellungen initalisierten" />

                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="100"
                    Margin="0,5,0,0"
                    Command="{Binding Path=InitSettingsCommand}"
                    CommandParameter="init"
                    Content="Initalisieren" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Height="20"
                    HorizontalAlignment="Left"
                    Text="Einstellungen laden" />

                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    Width="100"
                    Margin="0,5,0,0"
                    Command="{Binding Path=ReadSettingsCommand}"
                    CommandParameter="read"
                    Content="Laden" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Height="20"
                    HorizontalAlignment="Left"
                    Text="Einstellungen Verzeichnis" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    Height="20"
                    HorizontalAlignment="Left"
                    FontWeight="Black"
                    Text="{Binding Path=SettingsPfad, FallbackValue=~SettingsPfad}" />

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Height="20"
                    HorizontalAlignment="Left"
                    Text="Einstellungen Properties" />

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    Height="20"
                    HorizontalAlignment="Left"
                    FontWeight="Black"
                    Text="{Binding Path=SettingsProperties, FallbackValue=~SettingsProperties}" />

                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    Height="20"
                    HorizontalAlignment="Left"
                    Text="Property 'LetzterZugriff'" />

                <TextBlock
                    Grid.Row="4"
                    Grid.Column="1"
                    Height="20"
                    HorizontalAlignment="Left"
                    FontWeight="Black"
                    Text="{Binding Path=SettingsLastAccess, FallbackValue=~SettingsLastAccess}" />

                <TextBlock
                    Grid.Row="5"
                    Grid.Column="0"
                    Height="20"
                    HorizontalAlignment="Left"
                    Text="Property 'FrageExit'" />

                <CheckBox
                    Grid.Row="5"
                    Grid.Column="1"
                    IsChecked="{Binding Path=SettingsFrageExit, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Row="6"
                    Grid.Column="0"
                    Height="20"
                    HorizontalAlignment="Left"
                    Text="Änderung speichen" />

                <Button
                    Grid.Row="6"
                    Grid.Column="1"
                    Width="100"
                    Margin="0,5,0,0"
                    Command="{Binding Path=ReadSettingsCommand}"
                    CommandParameter="save"
                    Content="Speichern" />
            </Grid>

        </GroupBox>
    </Grid>
</base:UserControlBase>
