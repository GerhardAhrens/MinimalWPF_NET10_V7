<base:UserControlBase
    x:Class="MinimalWPF.Beispiel.CustomDataTypeUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:beispiel="clr-namespace:MinimalWPF.Beispiele"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MinimalWPF.Beispiel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid
        x:Name="gridMain"
        Background="WhiteSmoke"
        ColumnDefinitions="*"
        RowDefinitions="Auto,auto,*">

        <!--#region Hauptmenübar-->
        <GroupBox
            x:Name="MainMenubar"
            Grid.Row="0"
            Margin="5"
            Padding="5">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>
            <DockPanel Grid.Row="0" Grid.Column="0">
                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=GoBackCommand}"
                    CommandParameter="{x:Static beispiel:CommandButtons.GoBack}"
                    ToolTip="Zurück">
                    <Image Source="{StaticResource ResourceKey=IconGoBack}" Stretch="Uniform" />
                </Button>

            </DockPanel>
        </GroupBox>

        <!--#endregion Hauptmenübar-->

        <GroupBox
            Grid.Row="1"
            Padding="10"
            BorderBrush="Gray">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="Blue"
                        Text="Erklärung" />
                </StackPanel>
            </GroupBox.Header>

            <TextBlock FontSize="13" TextWrapping="Wrap">
                <Run Text="Ein Custom Data Type (benutzerdefinierter Datentyp, CDT) dient primär dazu, Daten in einer sinnvollen Struktur zusammenzufassen." />
                <LineBreak />
                <Run Text="Custom Data Types sind besonders gut geeignet, wenn du zusammengehörige Daten als eigenständigen Typ modellieren möchtest, anstatt primitive Typen wie string, int oder decimal überall direkt zu verwenden." />
                <LineBreak />
                <Run Text="Ein weiter Vorteil besteht darin, das CDT besser lesbar und dem vertauschen von Parametern vorbeugen. So ist" />
                <Run
                    Background="LightGray"
                    Foreground="Black"
                    Text="public record EmailAddress(string Value); EmailAddress = " />
                <Run Text="deutlicher erkennbar als" />
                <Run
                    Background="LightGray"
                    Foreground="Black"
                    Text="string email = &quot;max.mustermann@beispiel.de &quot;" />
            </TextBlock>
        </GroupBox>

        <GroupBox
            Grid.Row="2"
            Padding="10"
            BorderBrush="Gray">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="Blue"
                        Text="Beispiel" />
                </StackPanel>
            </GroupBox.Header>
            <TextBox
                x:Name="TxtSyntaxBox"
                beispiel:SyntaxBox.AutoIndent="True"
                beispiel:SyntaxBox.Enable="True"
                beispiel:SyntaxBox.ExpandTabs="False"
                beispiel:SyntaxBox.LineNumbersBackground="LightGray"
                beispiel:SyntaxBox.LineNumbersForeground="SlateGray"
                beispiel:SyntaxBox.ShowLineNumbers="True"
                AcceptsReturn="True"
                AcceptsTab="True"
                FontFamily="Consolas"
                FontSize="11pt"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto" >
                <beispiel:SyntaxBox.SyntaxDrivers>
                    <beispiel:SyntaxConfig>
                        <!--  Keywords  -->
                        <beispiel:KeywordRule Foreground="Blue" Keywords="abstract,as,base,bool,break,byte,case,catch,char,checked,class,const,continue,decimal,default,delegate,do,double,else,enum,event,explicit,extern,false,finally,fixed,float,for,foreach,goto,if,implicit,in,int,interface,internal,is,lock,long,namespace,new,null,object,operator,out,override,params,private,protected,public,readonly,ref,return,sbyte,sealed,short,sizeof,stackalloc,static,string,struct,switch,this,throw,true,try,typeof,uint,ulong,unchecked,unsafe,ushort,using,using,static,virtual,void,volatile,while,get,set,yield,var" />

                        <!--  Operators  -->
                        <beispiel:KeywordRule
                                Foreground="Purple"
                                Keywords="!,+,-,/,*,%,=,&amp;,^,|,&lt;,&gt;"
                                WholeWordsOnly="False" />

                        <beispiel:RegexRule
                                Foreground="Purple"
                                Op="Line"
                                Pattern="[\!+-\/\*%=&amp;\^|\?&lt;&gt;]" />

                        <!--  Preproc directives  -->
                        <beispiel:RegexRule
                                Foreground="Gray"
                                Op="Line"
                                Pattern="^\s*#.*" />

                        <!--  String  -->
                        <beispiel:RegexRule
                                Foreground="Maroon"
                                Op="Line"
                                Pattern="&quot;(?:[^&quot;\\]|\\.)*&quot;" />

                        <!--  Verbatim string  -->
                        <beispiel:RegexRule
                                Foreground="Maroon"
                                Op="Block"
                                Pattern="@&quot;(?:[^&quot;])*&quot;" />

                        <!--  Comment  -->
                        <beispiel:RegexRule
                                Foreground="Green"
                                Op="Line"
                                Pattern="//.*" />

                        <!--  Multiline comment  -->
                        <beispiel:RegexRule
                                Foreground="Green"
                                Op="Block"
                                Pattern="(?m)/\*[^*]*\*+(?:[^\/*][^*]*\*+)*/" />


                    </beispiel:SyntaxConfig>
                </beispiel:SyntaxBox.SyntaxDrivers>
            </TextBox>
        </GroupBox>
    </Grid>
</base:UserControlBase>
