<base:UserControlBase
    x:Class="MinimalWPF.Beispiel.SingletonUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:beispiel="clr-namespace:MinimalWPF.Beispiele"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MinimalWPF.Beispiel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid
        x:Name="gridMain"
        Background="WhiteSmoke"
        ColumnDefinitions="*"
        RowDefinitions="Auto,auto,*">

        <!--#region Hauptmenübar-->
        <GroupBox
            x:Name="MainMenubar"
            Grid.Row="0"
            Margin="5"
            Padding="5">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>
            <DockPanel Grid.Row="0" Grid.Column="0">
                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=GoBackCommand}"
                    CommandParameter="{x:Static beispiel:CommandButtons.GoBack}"
                    ToolTip="Zurück">
                    <Image Source="{StaticResource ResourceKey=IconGoBack}" Stretch="Uniform" />
                </Button>

            </DockPanel>
        </GroupBox>

        <!--#endregion Hauptmenübar-->

        <GroupBox
            Grid.Row="1"
            Padding="10"
            BorderBrush="Gray">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="Blue"
                        Text="Erklärung" />
                </StackPanel>
            </GroupBox.Header>

            <TextBlock FontSize="13" TextWrapping="Wrap">
                <Run Text="Das Singelton Pattern ermöglicht eine Instanz zu erstellen und bei jedm Aufruf genau diese eine Instanz zurückzuliefern" />
                <Run Text="Die Singelton-Klasse ist als eine generisch Basisklasse implementiert. Über die Interfaces" />
                <Run
                    Background="LightGray"
                    Foreground="Black"
                    Text="ISingletonInitializable" />
                <Run Text="und" />
                <Run
                    Background="LightGray"
                    Foreground="Black"
                    Text="ISingletonReloadable" />
                <Run Text="kann gesteuert werden, ob zusätzlich eine Methode zum" />
                <Run
                    Background="LightGray"
                    Foreground="Black"
                    Text="Initialize()" />
                <Run Text="und" />
                <Run
                    Background="LightGray"
                    Foreground="Black"
                    Text="ReloadContent()" />
                <Run Text="implementiert werden können." />
            </TextBlock>
        </GroupBox>

        <GroupBox
            Grid.Row="2"
            Padding="10"
            BorderBrush="Gray">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="Blue"
                        Text="Beispiel" />
                </StackPanel>
            </GroupBox.Header>

            <Grid
                VerticalAlignment="Top"
                ColumnDefinitions="150,150,*"
                RowDefinitions="Auto,Auto,Auto,auto,auto,auto,auto">
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Height="20"
                    HorizontalAlignment="Left"
                    Text="Erste Instanz erstellen" />

                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="150"
                    Margin="0,5,0,0"
                    Command="{Binding Path=InitInstanzCommand}"
                    CommandParameter="init"
                    Content="Instanz erstellen" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Height="20"
                    HorizontalAlignment="Left"
                    Text="App Name" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    Height="20"
                    HorizontalAlignment="Left"
                    FontWeight="Black"
                    Text="{Binding Path=AppName, FallbackValue=~AppName}" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Height="20"
                    HorizontalAlignment="Left"
                    Text="Reload Default Instanz" />

                <Button
                    Grid.Row="2"
                    Grid.Column="1"
                    Width="150"
                    Margin="0,5,0,0"
                    Command="{Binding Path=ReloadInstanzCommand}"
                    CommandParameter="reload"
                    Content="Set Default Instanz" />

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Height="20"
                    HorizontalAlignment="Left"
                    Text="App Name (Init)" />

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    Height="20"
                    HorizontalAlignment="Left"
                    FontWeight="Black"
                    Text="{Binding Path=AppNameInit, FallbackValue=~AppNameInit}" />

                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    Height="20"
                    HorizontalAlignment="Left"
                    Text="App Name (Default)" />

                <TextBlock
                    Grid.Row="4"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    Height="20"
                    HorizontalAlignment="Left"
                    FontWeight="Black"
                    Text="{Binding Path=AppNameDefault, FallbackValue=~AppNameDefault}" />

                <TextBlock
                    Grid.Row="5"
                    Grid.Column="0"
                    Height="20"
                    HorizontalAlignment="Left"
                    Text="Instanz Equals" />

                <TextBlock
                    Grid.Row="5"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    Height="20"
                    HorizontalAlignment="Left"
                    FontWeight="Black"
                    Text="{Binding Path=InstanzEquals, FallbackValue=~InstanzEquals}" />
            </Grid>
        </GroupBox>
    </Grid>
</base:UserControlBase>
