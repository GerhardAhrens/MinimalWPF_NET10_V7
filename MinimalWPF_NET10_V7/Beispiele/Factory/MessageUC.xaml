<base:UserControlBase
    x:Class="MinimalWPF.Beispiele.MessageUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:beispiel="clr-namespace:MinimalWPF.Beispiele"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MinimalWPF.Beispiele"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid
        x:Name="gridMain"
        Background="WhiteSmoke"
        ColumnDefinitions="*"
        RowDefinitions="Auto,Auto,*">

        <!--#region Dialog Menütoolbar-->
        <GroupBox
            x:Name="MainMenubar"
            Grid.Row="0"
            Margin="5"
            Padding="5">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>
            <DockPanel Grid.Row="0" Grid.Column="0">
                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=GoBackCommand}"
                    CommandParameter="{x:Static beispiel:CommandButtons.GoBack}"
                    ToolTip="Zurück">
                    <Image Source="{StaticResource ResourceKey=IconGoBack}" Stretch="Uniform" />
                </Button>
            </DockPanel>
        </GroupBox>
        <!--#endregion Dialog Menütoolbar-->

        <GroupBox
            Grid.Row="1"
            Padding="10"
            BorderBrush="Gray">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="Blue"
                        Text="Erklärung" />
                </StackPanel>
            </GroupBox.Header>

            <TextBlock FontSize="13" TextWrapping="Wrap">
                <Run Text="Die MessageBox wurde um einen Basisklasse" />
                <Run
                    Background="LightGray"
                    Foreground="Black"
                    Text="MessageBase" />
                <Run Text="als Wrapper erweitert. So ist es nun möglich die MasseBox über Extension-Methoden anzusprechen. Auf diese Weise, können alle Meldungen in einer zentralen Klasse verwaltet werden." />
                <LineBreak />
                <Run
                    FontSize="14"
                    FontWeight="Bold"
                    Text="Beispiel:" />
                <Run FontSize="14" Text="MessageBoxResult msgYN = " />
                <Run
                    FontSize="14"
                    Foreground="SteelBlue"
                    Text="this." />
                <Run FontSize="14" Text="Message." />
                <Run
                    FontSize="14"
                    Foreground="Red"
                    Text="AppExitMessage();" />
            </TextBlock>
        </GroupBox>

        <GroupBox
            Grid.Row="2"
            Margin="0,10,0,0"
            Padding="10"
            BorderBrush="Gray">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="Blue"
                        Text="Beispiel" />
                </StackPanel>
            </GroupBox.Header>
            <!--  Inhalt der GroupBox  -->
            <StackPanel VerticalAlignment="Top" Orientation="Vertical">
                <Button
                    Height="30"
                    Command="{Binding Path=MessageBoxOKCommand}"
                    CommandParameter="OK"
                    Content="Beispiel MessageBox 'OK'" />

                <Button
                    Height="30"
                    Margin="0,10,0,0"
                    Command="{Binding Path=MessageBoxOKCommand}"
                    CommandParameter="YES_NO"
                    Content="Beispiel MessageBox Question (Yes/No)" />

                <Button
                    Height="30"
                    Margin="0,10,0,0"
                    Command="{Binding Path=MessageBoxOKCommand}"
                    CommandParameter="YES_NO_CANCEL"
                    Content="Beispiel MessageBox Question (Yes/No/Cancel)" />

                <Button
                    Height="30"
                    Margin="0,10,0,0"
                    Command="{Binding Path=MessageBoxOKCommand}"
                    CommandParameter="ABORT_RETRY_IGNORE"
                    Content="Beispiel MessageBox Question (Abort/Retry/Ignore)" />
            </StackPanel>
        </GroupBox>

    </Grid>
</base:UserControlBase>
