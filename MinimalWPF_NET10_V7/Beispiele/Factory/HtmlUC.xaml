<base:UserControlBase
    x:Class="MinimalWPF.Beispiel.HtmlUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:beispiel="clr-namespace:MinimalWPF.Beispiele"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MinimalWPF.Beispiel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid
        x:Name="gridMain"
        Background="WhiteSmoke"
        ColumnDefinitions="*"
        RowDefinitions="Auto,auto,*">

        <!--#region Hauptmenübar-->
        <GroupBox
            x:Name="MainMenubar"
            Grid.Row="0"
            Margin="5"
            Padding="5">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>
            <DockPanel Grid.Row="0" Grid.Column="0">
                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=GoBackCommand}"
                    CommandParameter="{x:Static beispiel:CommandButtons.GoBack}"
                    ToolTip="Zurück">
                    <Image Source="{StaticResource ResourceKey=IconGoBack}" Stretch="Uniform" />
                </Button>

            </DockPanel>
        </GroupBox>

        <!--#endregion Hauptmenübar-->

        <GroupBox
            Grid.Row="1"
            Padding="10"
            BorderBrush="Gray">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="Blue"
                        Text="Html Source" />
                </StackPanel>
            </GroupBox.Header>
            <TextBox
                x:Name="TxTHtmlPlain"
                Height="100"
                AcceptsReturn="True">
                <ContextMenuService.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Command="{Binding Path=HtmlSourceCommand}"
                            CommandParameter="html_tabelle"
                            Header="Tabelle" />
                        <MenuItem
                            Command="{Binding Path=HtmlSourceCommand}"
                            CommandParameter="html_color"
                            Header="Farbiger Text" />
                        <MenuItem
                            Command="{Binding Path=HtmlSourceCommand}"
                            CommandParameter="html_source"
                            Header="Source Code" />
                        <MenuItem
                            Command="{Binding Path=HtmlSourceCommand}"
                            CommandParameter="html_link"
                            Header="Html Link" />
                    </ContextMenu>
                </ContextMenuService.ContextMenu>
            </TextBox>
        </GroupBox>

        <GroupBox
            Grid.Row="2"
            Padding="10"
            BorderBrush="Gray">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="Blue"
                        Text="Formatiertes HTML" />
                </StackPanel>
            </GroupBox.Header>
            <base:HtmlTextBlock Text="{Binding Path=Text, ElementName=TxTHtmlPlain}" />
        </GroupBox>

    </Grid>
</base:UserControlBase>
