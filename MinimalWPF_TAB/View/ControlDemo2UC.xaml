<base:UserControlBase
    x:Class="MinimalWPF.View.ControlDemo2UC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:core="clr-namespace:MinimalWPF.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MinimalWPF.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DrawingImage x:Key="EditDrawingImage">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#FF0078D4" Geometry="M3,13 L3,17 L7,17 L17,7 L13,3 Z" />
            </DrawingImage.Drawing>
        </DrawingImage>
    </UserControl.Resources>

    <Grid
        x:Name="gridMain"
        Background="WhiteSmoke"
        ColumnDefinitions="*"
        RowDefinitions="Auto,*">

        <!--#region Hauptmenübar-->
        <GroupBox
            x:Name="MainMenubar"
            Grid.Row="0"
            Margin="5"
            Padding="5">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>
            <DockPanel Grid.Row="0" Grid.Column="0">
                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=GoBackCommand}"
                    CommandParameter="{x:Static core:CommandButtons.GoBack}"
                    ToolTip="Zurück">
                    <Image Source="{StaticResource ResourceKey=IconGoBack}" Stretch="Uniform" />
                </Button>

            </DockPanel>
        </GroupBox>
        <!--#endregion Hauptmenübar-->

        <Grid
            x:Name="gridControlDemo"
            Grid.Row="1"
            Grid.Column="0"
            Margin="5,0,0,0"
            Background="Transparent"
            ColumnDefinitions="120,*,100"
            RowDefinitions="200,Auto,*">

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="AdvancedListbox" />

            <UI:AdvancedListbox
                Grid.Row="0"
                Grid.Column="1"
                ActionButtonCommand="{Binding Path=ActionLBCommand}"
                ActionButtonImage="{StaticResource EditDrawingImage}"
                ActionButtonVisibility="Visible"
                DisplayMemberPath="ValueText"
                DisplayMemberPathForSearch="ValueText"
                DoubleClickCommand="{Binding Path=DoubleClickLBCommand}"
                FooterVisibility="Collapsed"
                HeaderText="Gruppen"
                ItemsSource="{Binding Path=DemoDateSource}"
                SelectionChangedCommand="{Binding Path=SelectLBCommand}"
                SelectionMode="Single" />

        </Grid>

    </Grid>
</base:UserControlBase>
