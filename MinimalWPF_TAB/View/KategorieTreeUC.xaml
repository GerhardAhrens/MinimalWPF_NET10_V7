<base:UserControlBase
    x:Class="MinimalWPF.View.KategorieTreeUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:core="clr-namespace:MinimalWPF.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MinimalWPF.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid
        x:Name="gridMain"
        Background="WhiteSmoke"
        ColumnDefinitions="*"
        RowDefinitions="Auto,*">

        <!--#region Hauptmenübar-->
        <GroupBox
            x:Name="MainMenubar"
            Grid.Row="0"
            Margin="5"
            Padding="5">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>
            <DockPanel Grid.Row="0" Grid.Column="0">
                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=GoBackCommand}"
                    CommandParameter="{x:Static core:CommandButtons.GoBack}"
                    ToolTip="Zurück">
                    <Image Source="{StaticResource ResourceKey=IconGoBack}" Stretch="Uniform" />
                </Button>

            </DockPanel>
        </GroupBox>

        <!--#endregion Hauptmenübar-->
        <UI:AdvancedTabControl
            x:Name="ArtikelTabControl"
            Grid.Row="1"
            SelectionChangedCommand="{Binding Path=SelectionChangedCommand}">
            <UI:AdvancedTabControl.Resources>

                <Style TargetType="{x:Type TabItem}">
                    <!--  Fehler 1 Behebung: Das Tag-Property sauber initialisieren  -->
                    <Setter Property="Tag" Value="" />

                    <!--  Fehler 2 Behebung: Explizites Setter.Value hinzufügen  -->
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <!--  Grid ist jetzt sauber innerhalb des DataTemplates gekapselt  -->
                                <Grid Margin="2,0,2,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Register-Beschriftung  -->
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding}" />

                                    <!--  Schließen-Button  -->
                                    <Button
                                        Grid.Column="1"
                                        Width="16"
                                        Height="16"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Content="×"
                                        Cursor="Hand"
                                        FontSize="14"
                                        FontWeight="Bold">

                                        <Button.Command>
                                            <Binding Path="CloseTabCommand" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" />
                                        </Button.Command>

                                        <Button.CommandParameter>
                                            <Binding RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type TabItem}}" />
                                        </Button.CommandParameter>

                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}">
                                                <Setter Property="Foreground" Value="#FF7F7F7F" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="Red" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </UI:AdvancedTabControl.Resources>

            <UI:AdvancedTabItem Header="Kategorien">
                <Grid ColumnDefinitions="*" RowDefinitions="35,*,25">

                    <Grid
                        Grid.Row="0"
                        Margin="5,5,0,0"
                        ColumnDefinitions="Auto,*"
                        RowDefinitions="*">
                        <TextBlock Grid.Column="0" Text="Filter" />
                        <TextBox
                            Grid.Column="1"
                            Height="22"
                            Margin="5,0,5,0"
                            Text="{Binding Path=TreeViewFilter, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <UI:AdvancedTreeView
                        x:Name="treeMain"
                        Grid.Row="1"
                        Margin="5,0,5,0"
                        DoubleClickCommand="{Binding Path=NodeDoubleClickedCommand}"
                        Filter="{Binding Path=TreeViewFilter, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding Path=Nodes}"
                        SelectedItem="{Binding Path=SelectedNode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectionChangedCommand="{Binding Path=NodeSelectedCommand}" />

                    <!--
                    <TextBlock Grid.Row="2" Text="{Binding Path=IsFiltered, ElementName=treeMain}" />
                    -->

                    <UI:StatusTreeView
                        Grid.Row="2"
                        Margin="5,0,5,0"
                        FilteredItemCount="{Binding Path=FilteredItemCount, ElementName=treeMain}"
                        IsFiltered="{Binding Path=IsFiltered, ElementName=treeMain}"
                        TotalItemCount="{Binding Path=TotalItemCount, ElementName=treeMain}" />

                </Grid>
            </UI:AdvancedTabItem>
        </UI:AdvancedTabControl>

    </Grid>
</base:UserControlBase>
