<base:UserControlBase
    x:Class="MinimalWPF.View.TabArtikelDetail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MinimalWPF.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid
        x:Name="gridMain"
        Background="Transparent"
        ColumnDefinitions="120,*"
        RowDefinitions="25,25,25,Auto,25,25,*">

        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Artikelnummer" />

        <TextBlock
            Grid.Row="0"
            Grid.Column="1"
            VerticalAlignment="Center"
            Text="{Binding Path=CurrentRow.Row[A], FallbackValue=~ArtikelId}" />

        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Artikelbezeichnung" />

        <TextBox
            Grid.Row="1"
            Grid.Column="1"
            Width="200"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Text="{Binding Path=CurrentRow.Row[B], FallbackValue=~ArtikelBezeichnung}" />

        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Artikelpreis" />

        <TextBox
            Grid.Row="2"
            Grid.Column="1"
            Width="100"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            UI:TextBoxDecimalBehaviors.IsDecimalOnly="True"
            Text="{Binding Path=CurrentRow.Row[C], FallbackValue=~ArtikelPreis}" />

        <UI:ListBoxImage
            x:Name="HorizontalImageList"
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Height="Auto"
            ImageHeight="32"
            ImageStretch="UniformToFill"
            ImageWidth="32"
            ItemsSource="{Binding Path=ImageSource}"
            Orientation="Horizontal"
            SelectedValue="{Binding Path=SelectedImage}"
            SymbolColor="Green" />

        <TextBlock
            Grid.Row="4"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="SelectedIndex" />

        <TextBlock
            Grid.Row="4"
            Grid.Column="1"
            Width="100"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Text="{Binding Path=SelectedImage}" />

        <TextBlock
            Grid.Row="5"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="TextBoxMask" />

        <StackPanel
            Grid.Row="5"
            Grid.Column="1"
            Orientation="Horizontal">
            <UI:TextBoxMask
                Width="200"
                HorizontalAlignment="Left"
                Mask="(00000) 00 00 00 00 00"
                RawText="{Binding Path=PhonNumberRaw}"
                Text="{Binding Path=PhonNumber, UpdateSourceTrigger=PropertyChanged}" />

            <UI:TextBoxMask
                Width="100"
                Margin="5,0,0,0"
                HorizontalAlignment="Left"
                Mask="&gt;LL LL"
                RawText="{Binding Path=KennzeichenRaw}"
                Text="{Binding Path=Kennzeichen, UpdateSourceTrigger=PropertyChanged}" />

            <Button
                Margin="10,0,0,0"
                Click="OnTestTextBoxMask"
                Content="Test Inhalt" />
        </StackPanel>

    </Grid>
</base:UserControlBase>
