<base:UserControlBase
    x:Class="MinimalWPF.View.TabArtikelDetail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MinimalWPF.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid
        x:Name="gridMain"
        Background="Transparent"
        ColumnDefinitions="120,*"
        RowDefinitions="25,25,25,*">

        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Artikelnummer" />

        <TextBlock
            Grid.Row="0"
            Grid.Column="1"
            VerticalAlignment="Center"
            Text="{Binding Path=CurrentRow.Row[A], FallbackValue=~ArtikelId}" />

        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Artikelbezeichnung" />

        <TextBox
            Grid.Row="1"
            Grid.Column="1"
            Width="200"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Text="{Binding Path=CurrentRow.Row[B], FallbackValue=~ArtikelBezeichnung}" />

        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Artikelpreis" />

        <TextBox
            Grid.Row="2"
            Grid.Column="1"
            Width="100"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            UI:TextBoxDecimalExtensions.IsDecimalOnly="True"
            Text="{Binding Path=CurrentRow.Row[C], FallbackValue=~ArtikelPreis}" />

    </Grid>
</base:UserControlBase>
