<base:WindowBase
    x:Class="MinimalWPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MinimalWPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding Path=WindowTitel, FallbackValue=~WindowTitel}"
    Width="950"
    Height="600"
    mc:Ignorable="d">

    <Grid
        x:Name="gridMain"
        ColumnDefinitions="*"
        RowDefinitions="*,Auto">

        <!--#region Contentbereich-->
        <Border
            Grid.Row="0"
            Grid.Column="0"
            Background="White"
            BorderBrush="Black"
            BorderThickness="0,1,0,1">
            <ContentControl
                x:Name="mainContent"
                Margin="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="LightGray"
                Content="{Binding Path=WorkContent, UpdateSourceTrigger=PropertyChanged}"
                ScrollViewer.CanContentScroll="True"
                VirtualizingPanel.IsVirtualizing="True"
                Visibility="Visible" />
        </Border>
        <!--#endregion Contentbereich-->

        <!--  StatusBar  -->
        <UI:StatusInfoBar x:Name="StatusBar" Grid.Row="4" Height="25" />
    </Grid>
</base:WindowBase>
