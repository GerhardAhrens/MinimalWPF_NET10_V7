<base:WindowBase
    x:Class="MinimalWPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MinimalWPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">

    <base:WindowBase.Resources>
        <Style x:Key="RowNumberStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="Green" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="0,0,6,0" />
        </Style>
    </base:WindowBase.Resources>

    <Grid ColumnDefinitions="*,200" RowDefinitions="35,*,35">
        <UI:FilterRow
            Grid.Row="0"
            Width="{Binding Path=ActualWidth, ElementName=lvwMain}"
            Height="30"
            Margin="0,0,0,-10"
            VerticalAlignment="Bottom"
            ListView="{Binding ElementName=lvwMain}" />

        <UI:AdvancedListView
            x:Name="lvwMain"
            Grid.Row="1"
            Margin="10"
            Background="WhiteSmoke"
            ContextMenuCommand="{Binding Path=ContextMenuClickCommand}"
            DoubleClickCommand="{Binding Path=SelectDataRowClickCommand}"
            ItemsSource="{Binding Path=DataSource}"
            RowNumberHeader="*"
            RowNumberTextStyle="{StaticResource RowNumberStyle}"
            SelectedItem="{Binding Path=SelectedDataRow, UpdateSourceTrigger=PropertyChanged}"
            SelectedItemChangedCommand="{Binding Path=SelectDataRowCommand}"
            SelectionMode="Single"
            ShowRowNumbers="True">
            <UI:AdvancedListView.ContextMenu>

                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">

                    <MenuItem
                        x:Name="ctxEdit"
                        Command="{Binding Path=EditCommand}"
                        CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                        Header="Bearbeiten" />

                    <MenuItem
                        x:Name="ctxDelete"
                        Command="{Binding Path=DeleteCommand}"
                        CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                        Header="Löschen" />
                </ContextMenu>

            </UI:AdvancedListView.ContextMenu>
            <ListView.View>
                <GridView>
                    <UI:AdvancedGridViewColumn
                        Width="60"
                        DisplayMemberBinding="{Binding Path=[A]}"
                        FilterType="Number"
                        Header="Art-Nr"
                        SortMemberPath="A" />

                    <UI:AdvancedGridViewColumn
                        Width="200"
                        DisplayMemberBinding="{Binding Path=[B]}"
                        FilterType="Text"
                        Header="Name"
                        SortMemberPath="B" />

                    <UI:AdvancedGridViewColumn
                        Width="70"
                        DisplayMemberBinding="{Binding Path=[C]}"
                        FilterType="Number"
                        Header="Preis"
                        SortMemberPath="C"
                        StringFormat="{}{0:N2} €"
                        TextAlignment="Right" />
                </GridView>
            </ListView.View>
        </UI:AdvancedListView>

        <UI:StatusRow
            Grid.Row="2"
            Height="20"
            Margin="0,-25,0,0"
            ListView="{Binding ElementName=lvwMain}" />

        <TextBlock
            Grid.Row="1"
            Grid.Column="1"
            Margin="10"
            FontSize="20"
            FontWeight="Bold"
            Text="{Binding Path=Id}" />
    </Grid>
</base:WindowBase>
