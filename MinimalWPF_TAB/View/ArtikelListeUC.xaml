<base:UserControlBase
    x:Class="MinimalWPF.View.ArtikellisteUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:core="clr-namespace:MinimalWPF.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MinimalWPF.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <system:Double x:Key="ButtonSize">40</system:Double>
    </UserControl.Resources>

    <Grid
        x:Name="gridMain"
        Background="WhiteSmoke"
        ColumnDefinitions="*"
        RowDefinitions="Auto,*">

        <!--#region Hauptmenübar-->
        <UI:MenuBar
            Grid.Row="0"
            Grid.ColumnSpan="2"
            ButtonSpacing="5"
            Header="Artikelmenü"
            ItemPadding="8,2"
            ShowBorder="True">
            <Button
                Width="{StaticResource ResourceKey=ButtonSize}"
                Height="{StaticResource ResourceKey=ButtonSize}"
                Background="Transparent"
                Command="{Binding Path=GoBackCommand}"
                CommandParameter="{x:Static core:CommandButtons.GoBack}"
                ToolTip="Zurüke zum Hauptmenü">
                <StackPanel Orientation="Horizontal">
                    <Image
                        Width="40"
                        Height="40"
                        Source="{StaticResource ResourceKey=IconGoBack}"
                        Stretch="Uniform" />
                </StackPanel>
            </Button>

        </UI:MenuBar>
        <!--#endregion Hauptmenübar-->
    </Grid>
</base:UserControlBase>
