<base:UserControlBase
    x:Class="MinimalWPF.View.ArtikellisteUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:core="clr-namespace:MinimalWPF.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MinimalWPF.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <system:Double x:Key="ButtonSize">40</system:Double>

        <Style x:Key="RowNumberStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="Green" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="0,0,6,0" />
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="gridMain"
        Background="WhiteSmoke"
        ColumnDefinitions="*"
        RowDefinitions="Auto,*">

        <!--#region Hauptmenübar-->
        <UI:MenuBar
            Grid.Row="0"
            Grid.ColumnSpan="2"
            ButtonSpacing="5"
            Header="Artikelmenü"
            ItemPadding="8,2"
            ShowBorder="True">

            <UI:MenuButton
                Command="{Binding Path=GoBackCommand}"
                CommandParameter="{x:Static core:CommandButtons.GoBack}"
                Image="{StaticResource ResourceKey=IconGoBack}"
                ToolTipText="Zurück zum Hauptmenü" />

        </UI:MenuBar>
        <!--#endregion Hauptmenübar-->

        <UI:AdvancedTabControl
            x:Name="ArtikelTabControl"
            Grid.Row="1"
            SelectionChangedCommand="{Binding Path=SelectionChangedCommand}">
            <UI:AdvancedTabControl.Resources>

                <Style TargetType="{x:Type TabItem}">
                    <!--  Fehler 1 Behebung: Das Tag-Property sauber initialisieren  -->
                    <Setter Property="Tag" Value="" />

                    <!--  Fehler 2 Behebung: Explizites Setter.Value hinzufügen  -->
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <!--  Grid ist jetzt sauber innerhalb des DataTemplates gekapselt  -->
                                <Grid Margin="2,0,2,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Register-Beschriftung  -->
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding}" />

                                    <!--  Schließen-Button  -->
                                    <Button
                                        Grid.Column="1"
                                        Width="16"
                                        Height="16"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Content="×"
                                        Cursor="Hand"
                                        FontSize="14"
                                        FontWeight="Bold">

                                        <Button.Command>
                                            <Binding Path="CloseTabCommand" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" />
                                        </Button.Command>

                                        <Button.CommandParameter>
                                            <Binding RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type TabItem}}" />
                                        </Button.CommandParameter>

                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}">
                                                <Setter Property="Foreground" Value="#FF7F7F7F" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="Red" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </UI:AdvancedTabControl.Resources>

            <UI:AdvancedTabItem Header="Artikelübersicht">
                <Grid ColumnDefinitions="*" RowDefinitions="Auto,*,25">
                    <UI:FilterRow
                        Grid.Row="0"
                        Width="{Binding Path=ActualWidth, ElementName=lvwMain}"
                        Height="30"
                        Margin="0,0,0,-10"
                        VerticalAlignment="Bottom"
                        ListView="{Binding ElementName=lvwMain}" />

                    <UI:AdvancedListView
                        x:Name="lvwMain"
                        Grid.Row="1"
                        Margin="0,10,0,10"
                        Background="WhiteSmoke"
                        DoubleClickCommand="{Binding Path=RowDoubleClickCommand}"
                        ItemsSource="{Binding Path=DataSource}"
                        RowNumberHeader="*"
                        RowNumberTextStyle="{StaticResource RowNumberStyle}"
                        SelectedItem="{Binding Path=SelectedDataRow, UpdateSourceTrigger=PropertyChanged}"
                        SelectedItemChangedCommand="{Binding Path=SelectDataRowCommand}"
                        SelectionMode="Single"
                        ShowRowNumbers="True">
                        <ListView.View>
                            <GridView>
                                <UI:AdvancedGridViewColumn
                                    Width="60"
                                    DisplayMemberBinding="{Binding Path=[A]}"
                                    FilterType="Number"
                                    Header="Art-Nr"
                                    SortMemberPath="A" />

                                <UI:AdvancedGridViewColumn
                                    Width="200"
                                    DisplayMemberBinding="{Binding Path=[B]}"
                                    FilterType="Text"
                                    Header="Name"
                                    SortMemberPath="B" />

                                <UI:AdvancedGridViewColumn
                                    Width="70"
                                    DisplayMemberBinding="{Binding Path=[C]}"
                                    FilterType="Number"
                                    Header="Preis"
                                    SortMemberPath="C"
                                    StringFormat="{}{0:N2} €"
                                    TextAlignment="Right" />

                                <UI:AdvancedGridViewColumn
                                    Width="200"
                                    DisplayMemberBinding="{Binding Path=[Warengruppe]}"
                                    FilterType="Text"
                                    Header="Warengruppe"
                                    SortMemberPath="Warengruppe" />
                            </GridView>
                        </ListView.View>
                    </UI:AdvancedListView>

                    <!--  Wird über der DataGrid dargestellt  -->
                    <UI:LoadingOverlay
                        Grid.Row="1"
                        IsActived="{Binding Path=IsLoading, UpdateSourceTrigger=PropertyChanged}"
                        Text="Daten werden geladen..." />

                    <UI:StatusListView
                        Grid.Row="2"
                        Height="20"
                        Margin="0,-25,0,0"
                        ListView="{Binding ElementName=lvwMain}" />

                </Grid>
            </UI:AdvancedTabItem>
        </UI:AdvancedTabControl>
    </Grid>
</base:UserControlBase>
