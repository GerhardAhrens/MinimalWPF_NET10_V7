<base:UserControlBase
    x:Class="System.Windows.LoginUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:System.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid x:Name="rootGrid" DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Border Background="#FAFAFB" CornerRadius="5">
            <Grid
                Margin="10"
                ColumnDefinitions="*"
                RowDefinitions="40,*,40">
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,0,10"
                    BorderBrush="DarkGray"
                    BorderThickness="0,0,0,2">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Medium"
                        Text="{Binding Path=LoginTitel, FallbackValue=~LoginTitel}" />
                </Border>

                <Grid
                    x:Name="GridNeuesKonto"
                    Grid.Row="1"
                    Grid.Column="0"
                    ColumnDefinitions="100,120,*"
                    RowDefinitions="100,25,25,25,25"
                    Visibility="Visible">
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="Anzeigename"
                        TextAlignment="Right" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Text="Benutzername"
                        TextAlignment="Right" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        Text="Passwort"
                        TextAlignment="Right" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        Text="Passwort wiederholen"
                        TextAlignment="Right" />
                </Grid>

                <Border
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,0,0,10"
                    BorderBrush="DarkGray"
                    BorderThickness="0,2,0,0"
                    Visibility="Visible">
                    <Grid ColumnDefinitions="120,*" RowDefinitions="*">
                        <Button
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,5,0,0"
                            Content="Neues Konto anlegen" />
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</base:UserControlBase>
