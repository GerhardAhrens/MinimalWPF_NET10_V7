<base:UserControlBase
    x:Class="System.Windows.LoginUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:System.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid x:Name="rootGrid" DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Border Background="#FAFAFB" CornerRadius="5">
            <Grid
                Margin="10"
                ColumnDefinitions="*"
                RowDefinitions="40,*,40">
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,0,10"
                    BorderBrush="DarkGray"
                    BorderThickness="0,0,0,2">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Medium"
                        Text="{Binding Path=LoginTitel, FallbackValue=~LoginTitel}" />
                </Border>

                <Grid
                    x:Name="GridNeuesKonto"
                    Grid.Row="1"
                    Grid.Column="0"
                    ColumnDefinitions="100,120,*"
                    RowDefinitions="100,30,30,30,30,30,30"
                    Visibility="Visible">
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="Anzeigename"
                        TextAlignment="Right" />

                    <TextBox
                        Grid.Row="1"
                        Grid.Column="3"
                        Width="400"
                        Height="22"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="Benutzername"
                        TextAlignment="Right" />

                    <TextBox
                        Grid.Row="2"
                        Grid.Column="3"
                        Width="200"
                        Height="22"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Left" />


                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="Passwort"
                        TextAlignment="Right" />

                    <TextBox
                        Grid.Row="3"
                        Grid.Column="3"
                        Width="200"
                        Height="22"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Left">
                        <i:Interaction.Behaviors>
                            <UI:PasswordTextBoxBehavior MaskCharacter="*" Password="{Binding Path=Password, Mode=TwoWay}" />
                        </i:Interaction.Behaviors>
                    </TextBox>

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="Passwort wiederholen"
                        TextAlignment="Right" />

                    <TextBox
                        Grid.Row="4"
                        Grid.Column="3"
                        Width="200"
                        Height="22"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Left">
                        <i:Interaction.Behaviors>
                            <UI:PasswordTextBoxBehavior MaskCharacter="*" Password="{Binding Path=PasswordRepeat, Mode=TwoWay}" />
                        </i:Interaction.Behaviors>
                    </TextBox>

                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        VerticalAlignment="Center"
                        Text="Bei der Verwendung einer PIN können Sie sich ohne Benutzername und Passwort anmelden"
                        TextAlignment="Left" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="Pin"
                        TextAlignment="Right" />

                    <TextBox
                        Grid.Row="6"
                        Grid.Column="3"
                        Width="100"
                        Height="22"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Left" />
                </Grid>

                <Border
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,0,0,10"
                    BorderBrush="DarkGray"
                    BorderThickness="0,2,0,0"
                    Visibility="Visible">
                    <Grid ColumnDefinitions="120,120,*" RowDefinitions="*">
                        <Button
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,5,0,0"
                            Content="Neues Konto anlegen" />

                        <Button
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="10,5,0,0"
                            Content="Konto löschen" />
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</base:UserControlBase>
