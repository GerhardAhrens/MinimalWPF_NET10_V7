<base:UserControlBase
    x:Class="System.Windows.LoginUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:core="clr-namespace:MinimalWPF.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:System.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Focusable="True"
    PreviewKeyDown="UserControlBase_PreviewKeyDown"
    mc:Ignorable="d">

    <UserControl.Resources>
        <sys:Double x:Key="ScaleXY">1.35</sys:Double>
    </UserControl.Resources>

    <Grid x:Name="rootGrid" DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Border Background="#FAFAFB" CornerRadius="5">
            <Grid
                Margin="10"
                ColumnDefinitions="*"
                RowDefinitions="40,*,40">
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,0,10"
                    BorderBrush="DarkGray"
                    BorderThickness="0,0,0,2">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Medium"
                        Text="{Binding Path=LoginTitel, FallbackValue=~LoginTitel}" />
                </Border>

                <Grid
                    x:Name="GridNeuesKonto"
                    Grid.Row="1"
                    Grid.Column="0"
                    ColumnDefinitions="100,120,*"
                    RowDefinitions="100,30,30,30,30,30,30,10,40"
                    Visibility="Collapsed">
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="Anzeigename"
                        TextAlignment="Right" />

                    <TextBox
                        Grid.Row="1"
                        Grid.Column="3"
                        Width="400"
                        Height="22"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{Binding Path=Displayname, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="Benutzername"
                        TextAlignment="Right" />

                    <TextBox
                        Grid.Row="2"
                        Grid.Column="3"
                        Width="200"
                        Height="22"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Left"
                        Text="{Binding Path=Benutzername, UpdateSourceTrigger=PropertyChanged}" />


                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="Passwort"
                        TextAlignment="Right" />

                    <TextBox
                        Grid.Row="3"
                        Grid.Column="3"
                        Width="200"
                        Height="22"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Left">
                        <i:Interaction.Behaviors>
                            <UI:PasswordTextBoxBehavior MaskCharacter="*" Password="{Binding Path=Password, Mode=TwoWay}" />
                        </i:Interaction.Behaviors>
                    </TextBox>

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="Passwort wiederholen"
                        TextAlignment="Right" />

                    <TextBox
                        Grid.Row="4"
                        Grid.Column="3"
                        Width="200"
                        Height="22"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Left">
                        <i:Interaction.Behaviors>
                            <UI:PasswordTextBoxBehavior MaskCharacter="*" Password="{Binding Path=PasswordRepeat, Mode=TwoWay}" />
                        </i:Interaction.Behaviors>
                    </TextBox>

                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        VerticalAlignment="Center"
                        Text="Bei der Verwendung einer PIN können Sie sich ohne Benutzername und Passwort anmelden"
                        TextAlignment="Left" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="Pin"
                        TextAlignment="Right" />

                    <TextBox
                        Grid.Row="6"
                        Grid.Column="3"
                        Width="100"
                        Height="22"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Left"
                        Text="{Binding Path=Pin, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel
                        Grid.Row="8"
                        Grid.Column="2"
                        Orientation="Horizontal">
                        <Button
                            Width="100"
                            Height="25"
                            Command="{Binding Path=CreateAccountCommand}"
                            Content="Konto erstellen" />

                        <Button
                            Width="100"
                            Height="25"
                            Margin="50,0,0,0"
                            Command="{Binding Path=CancelLoginCommand}"
                            CommandParameter="{x:Static core:CommandButtons.AppQuit}"
                            Content="Abbrechen" />
                    </StackPanel>
                </Grid>

                <Grid
                    x:Name="GridLoginPassword"
                    Grid.Row="1"
                    Grid.Column="0"
                    ColumnDefinitions="100,120,*"
                    RowDefinitions="100,30,30,10,30,10,40"
                    Visibility="Collapsed">
                    <Grid.LayoutTransform>
                        <ScaleTransform ScaleX="{StaticResource ResourceKey=ScaleXY}" ScaleY="{StaticResource ResourceKey=ScaleXY}" />
                    </Grid.LayoutTransform>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="Benutzername"
                        TextAlignment="Right" />

                    <TextBox
                        x:Name="BenutzernameInput"
                        Grid.Row="1"
                        Grid.Column="3"
                        Width="200"
                        Height="22"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Left"
                        Text="{Binding Path=Benutzername, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="Passwort"
                        TextAlignment="Right" />

                    <TextBox
                        x:Name="PasswordInput"
                        Grid.Row="2"
                        Grid.Column="3"
                        Width="200"
                        Height="22"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Left">
                        <i:Interaction.Behaviors>
                            <UI:PasswordTextBoxBehavior MaskCharacter="*" Password="{Binding Path=Password, Mode=TwoWay}" />
                        </i:Interaction.Behaviors>
                    </TextBox>

                    <StackPanel
                        Grid.Row="8"
                        Grid.Column="2"
                        Orientation="Horizontal">
                        <Button
                            Width="100"
                            Height="25"
                            Command="{Binding Path=LoginCommand}"
                            CommandParameter="PW"
                            Content="Anmelden" />

                        <Button
                            Width="100"
                            Height="25"
                            Margin="50,0,0,0"
                            Command="{Binding Path=CancelLoginCommand}"
                            CommandParameter="{x:Static core:CommandButtons.AppQuit}"
                            Content="Abbrechen" />
                    </StackPanel>
                </Grid>

                <Grid
                    x:Name="GridLoginPin"
                    Grid.Row="1"
                    Grid.Column="0"
                    ColumnDefinitions="100,120,*"
                    RowDefinitions="100,30,30,10,30,10,40"
                    Visibility="Collapsed">
                    <Grid.LayoutTransform>
                        <ScaleTransform ScaleX="{StaticResource ResourceKey=ScaleXY}" ScaleY="{StaticResource ResourceKey=ScaleXY}" />
                    </Grid.LayoutTransform>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="Benutzername"
                        TextAlignment="Right" />

                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="3"
                        Width="200"
                        Height="22"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Left"
                        DisplayMemberPath="Displayname"
                        IsReadOnly="True"
                        ItemsSource="{Binding Path=AccountSource}"
                        SelectedItem="{Binding Path=CurrentAccount, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValuePath="AccountId" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="Pin"
                        TextAlignment="Right" />

                    <TextBox
                        x:Name="PinInput"
                        Grid.Row="2"
                        Grid.Column="3"
                        Width="100"
                        Height="22"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Left"
                        DataObject.Pasting="OnPinInputPasting"
                        MaxLength="8"
                        PreviewKeyDown="OnPinInputPreviewKeyDown"
                        PreviewTextInput="OnPinInputPreviewTextInput">
                        <i:Interaction.Behaviors>
                            <UI:PasswordTextBoxBehavior MaskCharacter="*" Password="{Binding Path=Pin, Mode=TwoWay}" />
                        </i:Interaction.Behaviors>
                    </TextBox>

                    <StackPanel
                        Grid.Row="8"
                        Grid.Column="2"
                        Orientation="Horizontal">
                        <Button
                            Width="100"
                            Height="25"
                            Command="{Binding Path=LoginCommand}"
                            CommandParameter="PIN"
                            Content="Anmelden"
                            IsDefault="true" />

                        <Button
                            Width="100"
                            Height="25"
                            Margin="50,0,0,0"
                            Command="{Binding Path=CancelLoginCommand}"
                            CommandParameter="{x:Static core:CommandButtons.AppQuit}"
                            Content="Abbrechen" />
                    </StackPanel>
                </Grid>

                <Border
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,0,0,10"
                    BorderBrush="DarkGray"
                    BorderThickness="0,2,0,0"
                    Visibility="Visible">
                    <Grid ColumnDefinitions="120,120,*" RowDefinitions="*">
                        <Button
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="10,5,0,0"
                            Command="{Binding Path=ClearAccountCommand}"
                            Content="Konto löschen" />
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</base:UserControlBase>
