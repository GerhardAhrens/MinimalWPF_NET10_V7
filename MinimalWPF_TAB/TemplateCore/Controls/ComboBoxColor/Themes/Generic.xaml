<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls">

    <!--  Windows-11-inspirierte Farben  -->
    <SolidColorBrush x:Key="ColorComboBackground" Color="#FFF9F9F9" />
    <SolidColorBrush x:Key="ColorComboBorder" Color="#FFD1D1D1" />
    <SolidColorBrush x:Key="ColorComboHover" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="ColorComboSelected" Color="#FFE5F1FB" />
    <SolidColorBrush x:Key="ColorComboText" Color="#FF202020" />
    <SolidColorBrush x:Key="ColorComboMuted" Color="#FF666666" />
    <SolidColorBrush x:Key="ColorComboAccent" Color="#FF0067C0" />

    <!--  Gemeinsame Darstellung für Auswahl und Dropdown  -->
    <DataTemplate x:Key="ColorOptionTemplate" DataType="{x:Type UI:ColorOption}">
        <Grid Margin="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Width="26"
                Height="26"
                VerticalAlignment="Center"
                Background="{Binding Brush}"
                BorderBrush="#33000000"
                BorderThickness="1"
                CornerRadius="5" />

            <StackPanel
                Grid.Column="1"
                Margin="10,0,4,0"
                VerticalAlignment="Center">
                <TextBlock
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource ColorComboText}"
                    Text="{Binding Name}" />

                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="11"
                    Foreground="{DynamicResource ColorComboMuted}"
                    Text="{Binding HexCode}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!--  Container der Listeneinträge  -->
    <Style x:Key="ColorOptionContainerStyle" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Margin" Value="3,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border
                        x:Name="ItemBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ColorComboHover}" />
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ColorComboSelected}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ItemBorder" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Standardstil von ComboBoxColor  -->
    <Style TargetType="{x:Type UI:ComboBoxColor}">
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="{DynamicResource ColorComboBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource ColorComboText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorComboBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemTemplate" Value="{StaticResource ColorOptionTemplate}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ColorOptionContainerStyle}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type UI:ComboBoxColor}">
                    <Grid>
                        <Border
                            x:Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>

                                <!--  Aktuelle Auswahl  -->
                                <ContentPresenter
                                    Grid.Column="0"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{StaticResource ColorOptionTemplate}"
                                    IsHitTestVisible="False" />

                                <!--  Dropdown-Pfeil  -->
                                <ToggleButton
                                    x:Name="DropDownButton"
                                    Grid.Column="1"
                                    ClickMode="Press"
                                    Focusable="False"
                                    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border
                                                x:Name="ArrowBorder"
                                                Background="Transparent"
                                                CornerRadius="0,7,7,0">
                                                <Path
                                                    Width="10"
                                                    Height="6"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Data="M 0,0 L 5,5 L 10,0"
                                                    Stroke="{DynamicResource ColorComboText}"
                                                    StrokeEndLineCap="Round"
                                                    StrokeStartLineCap="Round"
                                                    StrokeThickness="1.6" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ArrowBorder" Property="Background" Value="{DynamicResource ColorComboHover}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                        </Border>

                        <!--  Dropdown  -->
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom"
                            PopupAnimation="Fade">

                            <Border
                                MinWidth="200"
                                MaxHeight="320"
                                Margin="0,5,0,0"
                                Background="{DynamicResource ColorComboBackground}"
                                BorderBrush="{DynamicResource ColorComboBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">

                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="14"
                                        Opacity="0.14"
                                        ShadowDepth="3" />
                                </Border.Effect>

                                <ScrollViewer
                                    Margin="3"
                                    CanContentScroll="True"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource ColorComboAccent}" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource ColorComboAccent}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="MainBorder" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
