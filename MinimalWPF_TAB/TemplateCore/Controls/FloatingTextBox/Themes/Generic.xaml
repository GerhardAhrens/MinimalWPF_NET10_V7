<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls">

    <Style TargetType="{x:Type UI:FloatingTextBox}">

        <!--  Größe  -->
        <Setter Property="Height" Value="55" />
        <Setter Property="MinWidth" Value="180" />

        <!--  Farben  -->
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="TitleForeground" Value="Gray" />

        <Setter Property="BorderBrush" Value="Gray" />
        <Setter Property="BorderThickness" Value="1" />

        <!--  Text  -->
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="0,0,0,0" />

        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />

        <!--  Label  -->
        <Setter Property="FloatingLabelFontSize" Value="12" />
        <Setter Property="FloatingLabelDuration" Value="0:0:0.18" />

        <!--  Caret  -->
        <Setter Property="CaretBrush" Value="{Binding Foreground, RelativeSource={RelativeSource Self}}" />

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="{x:Type UI:FloatingTextBox}">

                    <Grid SnapsToDevicePixels="True">
                        <!--  Rahmen  -->
                        <Border
                            x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />

                        <!--  Standard-WPF-Textbereich  -->
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Margin="12,16,12,4"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            IsTabStop="False"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                            VerticalScrollBarVisibility="Hidden" />

                        <!--  Floating Label  -->
                        <TextBlock
                            x:Name="PART_FloatingLabel"
                            Margin="12,0,12,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="16"
                            FontWeight="Normal"
                            Foreground="{TemplateBinding TitleForeground}"
                            IsHitTestVisible="False"
                            RenderTransformOrigin="0,0.5"
                            Text="{TemplateBinding Title}"
                            TextTrimming="CharacterEllipsis">

                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="LabelScale" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="LabelTranslate" X="0" Y="0" />
                                </TransformGroup>
                            </TextBlock.RenderTransform>

                        </TextBlock>

                        <!--  Animationszustände  -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="LabelStates">

                                <!--  Label innerhalb des Feldes  -->
                                <VisualState x:Name="Resting">

                                    <Storyboard>

                                        <DoubleAnimation
                                            Storyboard.TargetName="LabelScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1"
                                            Duration="{TemplateBinding FloatingLabelDuration}" />

                                        <DoubleAnimation
                                            Storyboard.TargetName="LabelScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1"
                                            Duration="{TemplateBinding FloatingLabelDuration}" />

                                        <DoubleAnimation
                                            Storyboard.TargetName="LabelTranslate"
                                            Storyboard.TargetProperty="Y"
                                            To="0"
                                            Duration="{TemplateBinding FloatingLabelDuration}" />

                                    </Storyboard>
                                </VisualState>

                                <!--  Label nach oben verkleinern  -->
                                <VisualState x:Name="Floating">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="LabelScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="0.75"
                                            Duration="{TemplateBinding FloatingLabelDuration}" />

                                        <DoubleAnimation
                                            Storyboard.TargetName="LabelScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="0.75"
                                            Duration="{TemplateBinding FloatingLabelDuration}" />

                                        <DoubleAnimation
                                            Storyboard.TargetName="LabelTranslate"
                                            Storyboard.TargetProperty="Y"
                                            To="-18"
                                            Duration="{TemplateBinding FloatingLabelDuration}" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>

                    <!--  Visuelle Zustände  -->
                    <ControlTemplate.Triggers>

                        <!--  Maus über dem Control  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="#FF707070" />
                        </Trigger>

                        <!--  Tastaturfokus  -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="#FF0067C0" />
                            <Setter TargetName="PART_Border" Property="BorderThickness" Value="2" />
                        </Trigger>

                        <!--  ReadOnly  -->
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="#FFF5F5F5" />
                        </Trigger>

                        <!--  Deaktiviert  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#FF999999" />
                            <Setter TargetName="PART_Border" Property="Background" Value="#FFF0F0F0" />
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="#FFD0D0D0" />
                            <Setter TargetName="PART_FloatingLabel" Property="Opacity" Value="0.65" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>
</ResourceDictionary>
