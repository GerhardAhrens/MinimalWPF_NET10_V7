<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls">

    <!--  =========================================================  -->
    <!--  MenuBar  -->
    <!--  =========================================================  -->

    <Style TargetType="{x:Type UI:MenuBar}">

        <Setter Property="Background" Value="#FFF8F8F8" />

        <Setter Property="BorderBrush" Value="#FFC8C8C8" />

        <Setter Property="BorderThickness" Value="1" />

        <Setter Property="Padding" Value="4" />

        <Setter Property="CornerRadius" Value="4" />

        <Setter Property="ItemsPanel">

            <Setter.Value>

                <ItemsPanelTemplate>

                    <UI:MenuBarPanel />

                </ItemsPanelTemplate>

            </Setter.Value>

        </Setter>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type UI:MenuBar}">

                    <Border
                        x:Name="OuterBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">

                        <DockPanel LastChildFill="True">

                            <!--  Header  -->

                            <Border
                                x:Name="HeaderBorder"
                                Margin="4,0,4,4"
                                DockPanel.Dock="Top">

                                <ContentPresenter VerticalAlignment="Center" ContentSource="Header" />

                            </Border>

                            <!--  Items  -->

                            <ItemsPresenter />

                        </DockPanel>

                    </Border>

                    <ControlTemplate.Triggers>

                        <!--  Rahmen ausblenden  -->

                        <Trigger Property="ShowBorder" Value="False">

                            <Setter TargetName="OuterBorder" Property="BorderThickness" Value="0" />

                        </Trigger>

                        <!--  Header ausblenden  -->

                        <Trigger Property="ShowHeader" Value="False">

                            <Setter TargetName="HeaderBorder" Property="Visibility" Value="Collapsed" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

    <!--  =========================================================  -->
    <!--  MenuBarSeparator  -->
    <!--  =========================================================  -->
    <Style TargetType="{x:Type UI:MenuBarSeparator}">

        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="6,2" />
        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="{x:Type UI:MenuBarSeparator}">

                    <Border
                        Width="{TemplateBinding LineThickness}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        Background="{TemplateBinding Brush}" />

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>