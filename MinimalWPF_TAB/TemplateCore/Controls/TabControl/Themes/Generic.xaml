<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls">

    <!--  =========================================================  -->
    <!--  AdvancedTabItem  -->
    <!--  =========================================================  -->

    <Style BasedOn="{StaticResource {x:Type TabItem}}" TargetType="{x:Type UI:AdvancedTabItem}">

        <Setter Property="Tag" Value="" />

        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!--  Grid ist jetzt sauber innerhalb des DataTemplates gekapselt  -->
                    <Grid
                        Margin="2,0,2,0"
                        Background="{Binding Path=HeaderBackground, RelativeSource={RelativeSource AncestorType=UI:AdvancedTabItem}}"
                        ColumnDefinitions="Auto,*,Auto,Auto">

                        <!--  Register-Beschriftung  -->
                        <Image
                            Grid.Column="0"
                            Width="16"
                            Height="16"
                            Margin="2"
                            Source="{Binding RelativeSource={RelativeSource AncestorType=UI:AdvancedTabItem}, Path=HeaderImage}" />

                        <TextBlock
                            Grid.Column="1"
                            Margin="4,0"
                            VerticalAlignment="Center"
                            Background="{Binding Path=HeaderBackground, RelativeSource={RelativeSource AncestorType=UI:AdvancedTabItem}}"
                            Foreground="{Binding Path=HeaderForeground, RelativeSource={RelativeSource AncestorType=UI:AdvancedTabItem}}"
                            Text="{Binding}" />

                        <!--  Schließen-Button  -->
                        <Button
                            Grid.Column="2"
                            Width="16"
                            Height="16"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="×"
                            Cursor="Hand"
                            FontSize="14"
                            FontWeight="Bold">

                            <Button.Command>
                                <Binding Path="CloseTabCommand" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" />
                            </Button.Command>

                            <Button.CommandParameter>
                                <Binding RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type TabItem}}" />
                            </Button.CommandParameter>

                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Foreground" Value="#FF7F7F7F" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="Red" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button
                            Grid.Column="3"
                            Width="22"
                            Height="22"
                            Margin="2"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Content="▼"
                            Cursor="Hand"
                            FontSize="14">
                            <Button.Command>
                                <Binding Path="DropDownCommand" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" />
                            </Button.Command>

                            <Button.CommandParameter>
                                <Binding RelativeSource="{RelativeSource Self}" />
                            </Button.CommandParameter>
                        </Button>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>

    </Style>
</ResourceDictionary>