<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls">

    <UI:SwitchThumbOffsetConverter x:Key="SwitchThumbOffsetConverter" />

    <Style TargetType="{x:Type UI:SwitchBox}">

        <Setter Property="Focusable" Value="True" />

        <Setter Property="Cursor" Value="Hand" />

        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="HorizontalContentAlignment" Value="Left" />

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type UI:SwitchBox}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>


                        <!--  =================================================  -->
                        <!--  SWITCH  -->
                        <!--  =================================================  -->

                        <Border
                            x:Name="SwitchTrack"
                            Width="{TemplateBinding SwitchWidth}"
                            Height="{TemplateBinding SwitchHeight}"
                            Background="{TemplateBinding OffColor}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            SnapsToDevicePixels="True">

                            <Grid>


                                <!--  =========================================  -->
                                <!--  Focus-Rahmen  -->
                                <!--  =========================================  -->

                                <Border
                                    x:Name="FocusBorder"
                                    Margin="-2"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                    BorderThickness="2"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Opacity="0" />


                                <!--  =========================================  -->
                                <!--  Thumb  -->
                                <!--  =========================================  -->

                                <Ellipse
                                    x:Name="SwitchThumb"
                                    Width="{TemplateBinding ThumbSize}"
                                    Height="{TemplateBinding ThumbSize}"
                                    Margin="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Fill="{TemplateBinding ThumbColor}">

                                    <Ellipse.RenderTransform>

                                        <TranslateTransform x:Name="ThumbTransform" X="0" />

                                    </Ellipse.RenderTransform>

                                    <Ellipse.Effect>

                                        <DropShadowEffect
                                            BlurRadius="3"
                                            Opacity="0.25"
                                            ShadowDepth="1" />

                                    </Ellipse.Effect>

                                </Ellipse>

                            </Grid>

                        </Border>


                        <!--  =================================================  -->
                        <!--  TEXT  -->
                        <!--  =================================================  -->

                        <Grid
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">


                            <!--  OFF  -->

                            <ContentPresenter
                                x:Name="OffContentPresenter"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding OffContent}" />


                            <!--  ON  -->

                            <ContentPresenter
                                x:Name="OnContentPresenter"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding OnContent}"
                                Visibility="Collapsed" />

                        </Grid>


                        <!--  =================================================  -->
                        <!--  VISUAL STATES  -->
                        <!--  =================================================  -->

                        <VisualStateManager.VisualStateGroups>


                            <!--  =============================================  -->
                            <!--  COMMON STATES  -->
                            <!--  =============================================  -->

                            <VisualStateGroup x:Name="CommonStates">

                                <VisualState x:Name="Normal" />


                                <VisualState x:Name="MouseOver">

                                    <Storyboard>

                                        <DoubleAnimation
                                            Storyboard.TargetName="SwitchTrack"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.9"
                                            Duration="0:0:0.1" />

                                    </Storyboard>

                                </VisualState>


                                <VisualState x:Name="Pressed">

                                    <Storyboard>

                                        <DoubleAnimation
                                            Storyboard.TargetName="SwitchTrack"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.75"
                                            Duration="0:0:0.05" />

                                    </Storyboard>

                                </VisualState>


                                <VisualState x:Name="Disabled">

                                    <Storyboard>

                                        <DoubleAnimation
                                            Storyboard.TargetName="SwitchTrack"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.45"
                                            Duration="0:0:0.1" />

                                        <DoubleAnimation
                                            Storyboard.TargetName="SwitchThumb"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.7"
                                            Duration="0:0:0.1" />

                                    </Storyboard>

                                </VisualState>

                            </VisualStateGroup>


                            <!--  =============================================  -->
                            <!--  CHECK STATES  -->
                            <!--  =============================================  -->

                            <VisualStateGroup x:Name="CheckStates">


                                <!--  =========================================  -->
                                <!--  AUS  -->
                                <!--  =========================================  -->

                                <VisualState x:Name="Unchecked">

                                    <Storyboard>

                                        <DoubleAnimation
                                            Storyboard.TargetName="ThumbTransform"
                                            Storyboard.TargetProperty="X"
                                            To="0"
                                            Duration="0:0:0.15" />

                                    </Storyboard>

                                </VisualState>


                                <!--  =========================================  -->
                                <!--  EIN  -->
                                <!--  =========================================  -->

                                <VisualState x:Name="Checked">

                                    <Storyboard>

                                        <DoubleAnimation
                                            Storyboard.TargetName="ThumbTransform"
                                            Storyboard.TargetProperty="X"
                                            To="18"
                                            Duration="0:0:0.15" />

                                    </Storyboard>

                                </VisualState>


                                <!--  =========================================  -->
                                <!--  UNBESTIMMT  -->
                                <!--  =========================================  -->

                                <VisualState x:Name="Indeterminate">

                                    <Storyboard>

                                        <DoubleAnimation
                                            Storyboard.TargetName="ThumbTransform"
                                            Storyboard.TargetProperty="X"
                                            To="9"
                                            Duration="0:0:0.15" />

                                    </Storyboard>

                                </VisualState>

                            </VisualStateGroup>


                            <!--  =============================================  -->
                            <!--  FOCUS STATES  -->
                            <!--  =============================================  -->

                            <VisualStateGroup x:Name="FocusStates">

                                <VisualState x:Name="Unfocused">

                                    <Storyboard>

                                        <DoubleAnimation
                                            Storyboard.TargetName="FocusBorder"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.05" />

                                    </Storyboard>

                                </VisualState>


                                <VisualState x:Name="Focused">

                                    <Storyboard>

                                        <DoubleAnimation
                                            Storyboard.TargetName="FocusBorder"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.05" />

                                    </Storyboard>

                                </VisualState>

                            </VisualStateGroup>

                        </VisualStateManager.VisualStateGroups>
                    </Grid>


                    <!--  =====================================================  -->
                    <!--  TRIGGERS  -->
                    <!--  =====================================================  -->

                    <ControlTemplate.Triggers>


                        <!--  ================================================  -->
                        <!--  CHECKED  -->
                        <!--  ================================================  -->

                        <Trigger Property="IsChecked" Value="True">

                            <!--  Farbe  -->

                            <Setter TargetName="SwitchTrack" Property="Background" Value="{Binding OnColor, RelativeSource={RelativeSource TemplatedParent}}" />


                            <!--  Text  -->

                            <Setter TargetName="OffContentPresenter" Property="Visibility" Value="Collapsed" />

                            <Setter TargetName="OnContentPresenter" Property="Visibility" Value="Visible" />

                        </Trigger>


                        <!--  ================================================  -->
                        <!--  UNCHECKED  -->
                        <!--  ================================================  -->

                        <Trigger Property="IsChecked" Value="False">

                            <!--  Farbe  -->

                            <Setter TargetName="SwitchTrack" Property="Background" Value="{Binding OffColor, RelativeSource={RelativeSource TemplatedParent}}" />


                            <!--  Text  -->

                            <Setter TargetName="OffContentPresenter" Property="Visibility" Value="Visible" />

                            <Setter TargetName="OnContentPresenter" Property="Visibility" Value="Collapsed" />

                        </Trigger>


                        <!--  ================================================  -->
                        <!--  INDETERMINATE  -->
                        <!--  ================================================  -->

                        <Trigger Property="IsChecked" Value="{x:Null}">

                            <Setter TargetName="SwitchTrack" Property="Background" Value="{Binding OffColor, RelativeSource={RelativeSource TemplatedParent}}" />

                            <Setter TargetName="OffContentPresenter" Property="Visibility" Value="Visible" />

                            <Setter TargetName="OnContentPresenter" Property="Visibility" Value="Collapsed" />

                        </Trigger>


                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>
</ResourceDictionary>