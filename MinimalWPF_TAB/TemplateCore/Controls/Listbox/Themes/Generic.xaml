<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls">

    <SolidColorBrush x:Key="AdvancedListbox.Surface" Color="#FFF9F9F9" />
    <SolidColorBrush x:Key="AdvancedListbox.Border" Color="#FFD1D1D1" />
    <SolidColorBrush x:Key="AdvancedListbox.Text" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="AdvancedListbox.SubtleText" Color="#FF666666" />
    <SolidColorBrush x:Key="AdvancedListbox.Hover" Color="#0F000000" />
    <SolidColorBrush x:Key="AdvancedListbox.Selected" Color="#1F0078D4" />
    <SolidColorBrush x:Key="AdvancedListbox.Focus" Color="#FF0078D4" />

    <Style TargetType="{x:Type UI:AdvancedListbox}">
        <Setter Property="Background" Value="{StaticResource AdvancedListbox.Surface}" />
        <Setter Property="Foreground" Value="{StaticResource AdvancedListbox.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource AdvancedListbox.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type UI:AdvancedListbox}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Header  -->
                            <Border
                                Grid.Row="0"
                                Padding="12"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="{TemplateBinding HeaderText}" />
                                    <Border
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock
                                                Margin="10,0,6,0"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="14"
                                                Foreground="{StaticResource AdvancedListbox.SubtleText}"
                                                Text="&#xE721;" />
                                            <TextBox
                                                Padding="4,8"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="13"
                                                Foreground="{TemplateBinding Foreground}"
                                                Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                                ToolTip="{TemplateBinding SearchPlaceholder}" />
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!--  Items  -->
                            <ScrollViewer
                                Grid.Row="1"
                                Padding="{TemplateBinding Padding}"
                                CanContentScroll="True"
                                Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>

                            <!--  Footer  -->
                            <Border
                                Grid.Row="2"
                                Padding="12,8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,1,0,0">
                                <DockPanel>
                                    <TextBlock
                                        DockPanel.Dock="Left"
                                        FontSize="12"
                                        Foreground="{StaticResource AdvancedListbox.SubtleText}"
                                        Text="{Binding FilteredCount, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0} angezeigt}" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontSize="12"
                                        Foreground="{StaticResource AdvancedListbox.SubtleText}"
                                        Text="{Binding TotalCount, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}Gesamt: {0}}" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="Margin" Value="0,1" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <Border
                                    x:Name="ItemBorder"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter
                                            Grid.Column="0"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        <Button
                                            Grid.Column="1"
                                            Width="28"
                                            Height="28"
                                            Margin="8,0,0,0"
                                            Padding="5"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding ActionButtonCommand, RelativeSource={RelativeSource AncestorType={x:Type UI:AdvancedListbox}}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Aktion"
                                            Visibility="{Binding ActionButtonVisibility, RelativeSource={RelativeSource AncestorType={x:Type UI:AdvancedListbox}}}">
                                            <Image
                                                Width="16"
                                                Height="16"
                                                Source="{Binding ActionButtonImage, RelativeSource={RelativeSource AncestorType={x:Type UI:AdvancedListbox}}}"
                                                Stretch="Uniform" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AdvancedListbox.Hover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AdvancedListbox.Selected}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
