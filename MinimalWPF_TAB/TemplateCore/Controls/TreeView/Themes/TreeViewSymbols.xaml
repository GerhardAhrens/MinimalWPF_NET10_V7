<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Geschlossenes Ordner-Symbol  -->
    <DrawingImage x:Key="TreeFolderClosed">

        <DrawingImage.Drawing>

            <GeometryDrawing
                Brush="Gold"
                Geometry="M 1,3 L 7,3 L 9,5 L 15,5 L 15,14 L 1,14 Z"
                Pen="{x:Null}" />

        </DrawingImage.Drawing>

    </DrawingImage>


    <!--  Geöffnetes Ordner-Symbol  -->
    <DrawingImage x:Key="TreeFolderOpen">

        <DrawingImage.Drawing>

            <GeometryDrawing Brush="Gold" Geometry="M 1,4 L 7,4 L 9,6 L 15,6 L 13,14 L 1,14 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="DarkGoldenrod" Thickness="2" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>

        </DrawingImage.Drawing>

    </DrawingImage>
</ResourceDictionary>