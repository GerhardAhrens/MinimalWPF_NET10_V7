<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="TreeViewSymbols.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <UI:ExpandedImageConverter x:Key="ExpandedImageConverter" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!--  Darstellung einer AdvancedTreeNode  -->
    <HierarchicalDataTemplate DataType="{x:Type UI:AdvancedTreeNode}" ItemsSource="{Binding Path=FilteredChildren}">

        <StackPanel Orientation="Horizontal">

            <Image
                Width="16"
                Height="16"
                Margin="0,0,6,0">

                <Image.Source>
                    <MultiBinding Converter="{StaticResource ExpandedImageConverter}">
                        <Binding Path="OpenImage" />
                        <Binding Path="ExpandedImage" />
                        <Binding Path="IsExpanded" />
                    </MultiBinding>
                </Image.Source>

            </Image>

            <TextBlock
                Padding="5,3,5,3"
                VerticalAlignment="Center"
                Text="{Binding Path=Text}" />

        </StackPanel>

    </HierarchicalDataTemplate>

    <Style TargetType="{x:Type TreeViewItem}">

        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />

        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />

        <Setter Property="Visibility" Value="{Binding IsFilterVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />


        <Style.Triggers>

            <DataTrigger Binding="{Binding HasContextMenu}" Value="True">

                <Setter Property="ContextMenu">

                    <Setter.Value>

                        <ContextMenu ItemsSource="{Binding ContextMenuItems}">

                            <ContextMenu.ItemContainerStyle>

                                <Style TargetType="{x:Type MenuItem}">

                                    <Setter Property="Header" Value="{Binding Header}" />

                                    <Setter Property="Icon" Value="{Binding Icon}" />

                                    <Setter Property="Command" Value="{Binding Command}" />

                                    <Setter Property="CommandParameter" Value="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                    <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />

                                </Style>

                            </ContextMenu.ItemContainerStyle>

                        </ContextMenu>

                    </Setter.Value>

                </Setter>

            </DataTrigger>

        </Style.Triggers>

    </Style>
    
    <!--  AdvancedTreeView  -->
    <Style BasedOn="{StaticResource {x:Type TreeView}}" TargetType="{x:Type UI:AdvancedTreeView}" />

</ResourceDictionary>