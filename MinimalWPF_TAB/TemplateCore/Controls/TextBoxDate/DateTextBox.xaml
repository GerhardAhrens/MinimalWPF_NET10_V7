<UserControl
    x:Class="System.Windows.Controls.DateTextBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:System.Windows.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="WeekdayStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,5" />
        </Style>

        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="BorderBrushNormal" Color="#D1D5DB" />
        <SolidColorBrush x:Key="HoverBrush" Color="#F3F4F6" />
        <SolidColorBrush x:Key="TextBrush" Color="#1F2937" />

        <Style x:Key="CalendarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D1D5DB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DateInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,0,4,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border
            x:Name="InputBorder"
            Background="White"
            BorderBrush="{StaticResource BorderBrushNormal}"
            BorderThickness="1"
            CornerRadius="4">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="PART_TextBox"
                    Grid.Column="0"
                    LostFocus="PART_TextBox_LostFocus"
                    PreviewKeyDown="PART_TextBox_PreviewKeyDown"
                    Style="{StaticResource DateInputStyle}"
                    TextChanged="PART_TextBox_TextChanged" />

                <Button
                    Grid.Column="1"
                    Click="CalendarButton_Click"
                    Style="{StaticResource CalendarButtonStyle}"
                    ToolTip="Kalender öffnen">
                    <TextBlock
                        FontFamily="Segoe Fluent Icons"
                        FontSize="16"
                        Text="&#xE787;" />
                </Button>
            </Grid>
        </Border>

        <Popup
            x:Name="PART_Popup"
            AllowsTransparency="True"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=InputBorder}"
            PopupAnimation="Fade"
            StaysOpen="False"
            VerticalOffset="5">

            <Border
                Width="310"
                Padding="14"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="6">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="20"
                        Opacity="0.14"
                        ShadowDepth="4" />
                </Border.Effect>

                <StackPanel>
                    <!--  Monat und Jahr direkt auswählen  -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Height="34"
                            Click="PreviousMonth_Click"
                            Style="{StaticResource CalendarButtonStyle}"
                            ToolTip="Vorheriger Monat">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE76B;" />
                        </Button>

                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <ComboBox
                                x:Name="PART_MonthCombo"
                                Width="118"
                                Height="32"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="14"
                                SelectionChanged="MonthCombo_SelectionChanged" />

                            <ComboBox
                                x:Name="PART_YearCombo"
                                Width="76"
                                Height="32"
                                Margin="4,0,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="14"
                                SelectionChanged="YearCombo_SelectionChanged" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Height="34"
                            Click="NextMonth_Click"
                            Style="{StaticResource CalendarButtonStyle}"
                            ToolTip="Nächster Monat">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE76C;" />
                        </Button>
                    </Grid>

                    <!--  Wochentage  -->
                    <UniformGrid Margin="0,0,0,4" Columns="7">
                        <TextBlock Style="{StaticResource WeekdayStyle}" Text="Mo" />
                        <TextBlock Style="{StaticResource WeekdayStyle}" Text="Di" />
                        <TextBlock Style="{StaticResource WeekdayStyle}" Text="Mi" />
                        <TextBlock Style="{StaticResource WeekdayStyle}" Text="Do" />
                        <TextBlock Style="{StaticResource WeekdayStyle}" Text="Fr" />
                        <TextBlock Style="{StaticResource WeekdayStyle}" Text="Sa" />
                        <TextBlock Style="{StaticResource WeekdayStyle}" Text="So" />
                    </UniformGrid>

                    <!--  Tage werden dynamisch erzeugt  -->
                    <UniformGrid
                        x:Name="PART_DaysGrid"
                        Columns="7"
                        Rows="6" />

                    <Border
                        Height="1"
                        Margin="0,12,0,8"
                        Background="#E5E7EB" />

                    <DockPanel>
                        <Button
                            Padding="10,5"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="Today_Click"
                            Content="Heute"
                            Cursor="Hand" />

                        <Button
                            Padding="10,5"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="Clear_Click"
                            Content="Löschen"
                            Cursor="Hand"
                            DockPanel.Dock="Right" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
