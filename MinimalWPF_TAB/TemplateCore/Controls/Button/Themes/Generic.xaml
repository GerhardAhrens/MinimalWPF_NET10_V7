<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls">

    <UI:ImageVisibilityConverter x:Key="ImageVisibilityConverter" />

    <SolidColorBrush x:Key="WindowButton.Background" Color="#F9F9F9" />
    <SolidColorBrush x:Key="WindowButton.BackgroundHover" Color="#F3F3F3" />
    <SolidColorBrush x:Key="WindowButton.BackgroundPressed" Color="#E8E8E8" />
    <SolidColorBrush x:Key="WindowButton.Border" Color="#D1D1D1" />
    <SolidColorBrush x:Key="WindowButton.BorderHover" Color="#C7C7C7" />
    <SolidColorBrush x:Key="WindowButton.Foreground" Color="#1A1A1A" />
    <SolidColorBrush x:Key="WindowButton.DisabledForeground" Color="#9A9A9A" />
    <SolidColorBrush x:Key="WindowButton.DisabledBackground" Color="#F5F5F5" />

    <!--  Windows Accent  -->
    <SolidColorBrush x:Key="WindowButton.Accent" Color="#0067C0" />
    <SolidColorBrush x:Key="WindowButton.FocusRing" Color="#0067C0" />

    <Style TargetType="{x:Type UI:WindowButton}">

        <!--  Basic appearance  -->

        <Setter Property="Background" Value="{StaticResource WindowButton.Background}" />
        <Setter Property="BorderBrush" Value="{StaticResource WindowButton.Border}" />
        <Setter Property="Foreground" Value="{StaticResource WindowButton.Foreground}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type UI:WindowButton}">
                    <Grid>
                        <Border
                            x:Name="FocusRing"
                            Margin="-3"
                            BorderBrush="{StaticResource WindowButton.FocusRing}"
                            BorderThickness="2"
                            CornerRadius="7"
                            Visibility="Collapsed" />

                        <!--  Main Button  -->
                        <Border
                            x:Name="OuterBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">

                            <Grid>

                                <Border
                                    x:Name="DefaultIndicator"
                                    Width="3"
                                    Margin="1,4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Background="{StaticResource WindowButton.Accent}"
                                    CornerRadius="2"
                                    Visibility="Collapsed" />

                                <!--
                                    Button content
                                -->
                                <Grid Margin="{TemplateBinding Padding}">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="LeftImageColumn" Width="Auto" />

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition x:Name="RightImageColumn" Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--
                                        Left image
                                    -->
                                    <Image
                                        x:Name="LeftImage"
                                        Grid.Column="0"
                                        Width="{TemplateBinding ImageSize}"
                                        Height="{TemplateBinding ImageSize}"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Source="{TemplateBinding Image}"
                                        Stretch="Uniform">
                                        <Image.Visibility>
                                            <MultiBinding Converter="{StaticResource ImageVisibilityConverter}">

                                                <!--  Image  -->
                                                <Binding Path="Image" RelativeSource="{RelativeSource TemplatedParent}" />

                                                <!--  ImagePlacement  -->
                                                <Binding Path="ImagePlacement" RelativeSource="{RelativeSource TemplatedParent}" />

                                                <!--  Required placement  -->
                                                <MultiBinding.ConverterParameter>
                                                    <x:Static Member="UI:WindowButtonImagePlacement.Left" />
                                                </MultiBinding.ConverterParameter>

                                            </MultiBinding>
                                        </Image.Visibility>
                                    </Image>

                                    <!--
                                        Text / Content
                                    -->
                                    <ContentPresenter
                                        x:Name="ContentPresenter"
                                        Grid.Column="1"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Content="{TemplateBinding Content}"
                                        ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        RecognizesAccessKey="True" />

                                    <!--
                                        Right image
                                    -->
                                    <Image
                                        x:Name="RightImage"
                                        Grid.Column="2"
                                        Width="{TemplateBinding ImageSize}"
                                        Height="{TemplateBinding ImageSize}"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Source="{TemplateBinding Image}"
                                        Stretch="Uniform">
                                        <Image.Visibility>

                                            <MultiBinding Converter="{StaticResource ImageVisibilityConverter}">

                                                <!--  Image  -->
                                                <Binding Path="Image" RelativeSource="{RelativeSource TemplatedParent}" />

                                                <!--  ImagePlacement  -->
                                                <Binding Path="ImagePlacement" RelativeSource="{RelativeSource TemplatedParent}" />

                                                <!--  Required placement  -->
                                                <MultiBinding.ConverterParameter>
                                                    <x:Static Member="UI:WindowButtonImagePlacement.Right" />
                                                </MultiBinding.ConverterParameter>

                                            </MultiBinding>

                                        </Image.Visibility>
                                    </Image>

                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>

                        <!--
                            MOUSE OVER
                        -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBorder" Property="Background" Value="{StaticResource WindowButton.BackgroundHover}" />
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource WindowButton.BorderHover}" />
                        </Trigger>


                        <!--
                            PRESSED
                        -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="OuterBorder" Property="Background" Value="{StaticResource WindowButton.BackgroundPressed}" />
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource WindowButton.Border}" />
                        </Trigger>


                        <!--
                            KEYBOARD FOCUS
                        -->
                        <Trigger Property="IsKeyboardFocused" Value="True">

                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />

                        </Trigger>


                        <!--
                            DEFAULT BUTTON
                        -->
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="DefaultIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource WindowButton.Accent}" />
                        </Trigger>


                        <!--
                            DEFAULT + HOVER
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>

                            <Setter TargetName="OuterBorder" Property="Background" Value="{StaticResource WindowButton.BackgroundHover}" />
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource WindowButton.Accent}" />

                        </MultiTrigger>


                        <!--
                            DEFAULT + PRESSED
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>

                            <Setter TargetName="OuterBorder" Property="Background" Value="{StaticResource WindowButton.BackgroundPressed}" />
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource WindowButton.Accent}" />

                        </MultiTrigger>

                        <!--
                            IMAGE LEFT
                        -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Image, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}" />
                            </MultiDataTrigger.Conditions>

                            <Setter TargetName="LeftImage" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RightImage" Property="Visibility" Value="Collapsed" />

                        </MultiDataTrigger>


                        <MultiDataTrigger>

                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Image, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}" />
                                <Condition Binding="{Binding ImagePlacement, RelativeSource={RelativeSource TemplatedParent}}" Value="Left" />
                            </MultiDataTrigger.Conditions>

                            <Setter TargetName="LeftImage" Property="Visibility" Value="Collapsed" />

                        </MultiDataTrigger>


                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Image, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}" />
                                <Condition Binding="{Binding ImagePlacement, RelativeSource={RelativeSource TemplatedParent}}" Value="Right" />
                            </MultiDataTrigger.Conditions>

                            <Setter TargetName="RightImage" Property="Visibility" Value="Collapsed" />

                        </MultiDataTrigger>


                        <!--
                            IMAGE EXISTS + LEFT
                        -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Image, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}" />
                            </MultiDataTrigger.Conditions>

                            <Setter TargetName="LeftImage" Property="Visibility" Value="Collapsed" />

                        </MultiDataTrigger>


                        <!--
                            IMAGE PLACEMENT LEFT
                        -->
                        <DataTrigger Binding="{Binding ImagePlacement, RelativeSource={RelativeSource TemplatedParent}}" Value="Left">
                            <Setter TargetName="LeftImage" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RightImage" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>


                        <!--
                            IMAGE PLACEMENT RIGHT
                        -->
                        <DataTrigger Binding="{Binding ImagePlacement, RelativeSource={RelativeSource TemplatedParent}}" Value="Right">
                            <Setter TargetName="LeftImage" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RightImage" Property="Visibility" Value="Visible" />
                        </DataTrigger>


                        <!--
                            DISABLED
                        -->
                        <Trigger Property="IsEnabled" Value="False">

                            <Setter TargetName="OuterBorder" Property="Background" Value="{StaticResource WindowButton.DisabledBackground}" />
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource WindowButton.Border}" />
                            <Setter Property="Foreground" Value="{StaticResource WindowButton.DisabledForeground}" />
                            <Setter TargetName="DefaultIndicator" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
