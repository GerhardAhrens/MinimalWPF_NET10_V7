<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls">

    <!--  =============================================================  -->
    <!--  Brushes  -->
    <!--  =============================================================  -->

    <SolidColorBrush x:Key="Window11TextBox.Background" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Window11TextBox.Background.Disabled" Color="#F3F3F3" />
    <SolidColorBrush x:Key="Window11TextBox.Background.ReadOnly" Color="#F9F9F9" />
    <SolidColorBrush x:Key="Window11TextBox.Foreground" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Window11TextBox.Foreground.Disabled" Color="#9A9A9A" />
    <SolidColorBrush x:Key="Window11TextBox.Placeholder" Color="Gray" />
    <SolidColorBrush x:Key="Window11TextBox.Border" Color="#8A8A8A" />
    <SolidColorBrush x:Key="Window11TextBox.Border.Hover" Color="#5F5F5F" />
    <SolidColorBrush x:Key="Window11TextBox.Border.Focus" Color="#0067C0" />
    <SolidColorBrush x:Key="Window11TextBox.Border.Disabled" Color="#D6D6D6" />
    <SolidColorBrush x:Key="Window11TextBox.Border.Error" Color="#C42B1C" />

    <!--  =============================================================  -->
    <!--  Clear Button  -->
    <!--  =============================================================  -->

    <Style x:Key="Window11TextBox.ClearButton" TargetType="{x:Type Button}">

        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#5F5F5F" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4">

                        <Path
                            Width="10"
                            Height="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M 1,1 L 9,9 M 9,1 L 1,9"
                            Stretch="Fill"
                            Stroke="{TemplateBinding Foreground}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.6" />

                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#14000000" />
                            <Setter Property="Foreground" Value="#1A1A1A" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--  =============================================================  -->
    <!--  Window11TextBox  -->
    <!--  =============================================================  -->
    <Style TargetType="{x:Type UI:WindowTextBox}">

        <Setter Property="Background" Value="{DynamicResource Window11TextBox.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Window11TextBox.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Window11TextBox.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="4,1,8,1" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource Window11TextBox.PlaceholderForeground}" />
        <Setter Property="ShowClearButton" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type UI:WindowTextBox}">
                    <Grid>
                        <Border
                            x:Name="OuterBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            SnapsToDevicePixels="True">

                            <Grid>
                                <!--  Text  -->
                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalScrollBarVisibility="Hidden" />

                                <!--  Placeholder  -->
                                <TextBlock
                                    x:Name="PART_Placeholder"
                                    Margin="{TemplateBinding Padding}"
                                    Padding="4,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontStretch="{TemplateBinding FontStretch}"
                                    FontStyle="{TemplateBinding FontStyle}"
                                    FontWeight="{TemplateBinding FontWeight}"
                                    Foreground="{TemplateBinding PlaceholderForeground}"
                                    IsHitTestVisible="False"
                                    Text="{TemplateBinding PlaceholderText}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{Binding PlaceholderVisibility, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Grid>
                        </Border>

                        <!--  Clear Button  -->
                        <Button
                            x:Name="PART_ClearButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource Window11TextBox.ClearButton}"
                            Visibility="Collapsed" />

                    </Grid>


                    <ControlTemplate.Triggers>

                        <!--  Hover  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource Window11TextBox.Border.Hover}" />
                        </Trigger>


                        <!--  Focus  -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource Window11TextBox.Border.Focus}" />
                            <Setter TargetName="OuterBorder" Property="BorderThickness" Value="2" />
                        </Trigger>


                        <!--  Disabled  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource Window11TextBox.Background.Disabled}" />
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource Window11TextBox.Border.Disabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource Window11TextBox.Foreground.Disabled}" />
                        </Trigger>


                        <!--  ReadOnly  -->
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource Window11TextBox.Background.ReadOnly}" />
                        </Trigger>


                        <!--  Validation  -->
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource Window11TextBox.Border.Error}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
