<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UI="clr-namespace:System.Windows.Controls">

    <Style TargetType="{x:Type UI:ProgressOverlay}">

        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Panel.ZIndex" Value="1000" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type UI:ProgressOverlay}">

                    <Grid>
                        <Border Background="#80000000">
                            <Border
                                MinWidth="350"
                                Padding="25"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="White"
                                CornerRadius="6">

                                <StackPanel>

                                    <TextBlock
                                        Margin="0,0,0,15"
                                        HorizontalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="{TemplateBinding Text}"
                                        TextAlignment="Center" />

                                    <ProgressBar
                                        Height="20"
                                        Maximum="{TemplateBinding MaxValue}"
                                        Minimum="{TemplateBinding MinValue}"
                                        Value="{TemplateBinding Value}" />

                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsActived" Value="True">

                            <Setter Property="Visibility" Value="Visible" />

                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>