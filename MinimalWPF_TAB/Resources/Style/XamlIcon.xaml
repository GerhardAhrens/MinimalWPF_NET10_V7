<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--#region XAML Icon Quelle-->
    <!--
        https://pictogrammers.com/library/mdi/ (als DrawingImage)
        https://petershaggynoble.github.io/MDI-Sandbox/ (als Canvas)
        **********************************************************************
        In der Regel werden nur die direkten Vector-Daten verwendet. In einigen Fällen kann es aber hilfreich sein, das komplette
        DrawingImage zu verwenden, da dies direkt einem Image zugewiesen werden kann.
    -->
    <!--#endregion XAML Icon Quelle-->

    <!--#region Farbige Icon Symbole auf Basis von DrawingImage-->
    <DrawingImage x:Key="IconApplicationLogo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.Transform>
                    <ScaleTransform ScaleX="0.25" ScaleY="0.25" />
                </DrawingGroup.Transform>

                <GeometryDrawing Brush="#FFADACB3" Geometry="F1M14.664,151.738L198.916,151.738C205.606,151.738,211.032,146.312,211.032,139.625L211.032,12.114C211.032,5.423,205.606,0,198.916,0L14.664,0C7.973,0,2.55,5.423,2.55,12.114L2.55,139.625C2.55,146.312,7.973,151.738,14.664,151.738z" />
                <GeometryDrawing Brush="#FF1388B1" Geometry="F1M19.558,28.379C19.558,23.8,24.095,20.087,29.693,20.087L183.88,20.087C189.479,20.087,194.018,23.8,194.018,28.379L194.018,115.659C194.018,120.236,189.479,123.949,183.88,123.949L29.693,123.949C24.095,123.949,19.558,120.236,19.558,115.659L19.558,28.379z" />
                <GeometryDrawing Brush="#FFADACB3" Geometry="F1M189.449,188.078L124.303,188.078C120.822,188.078 118,185.255 118,181.775 118,178.294 120.822,175.468 124.303,175.468L189.449,175.468C192.93,175.468 195.752,178.294 195.752,181.775 195.752,185.255 192.93,188.078 189.449,188.078z M201.469,160.432L12.114,160.432C5.425,160.432,0,165.854,0,172.544L0,216.538C0,223.224,5.425,228.65,12.114,228.65L201.469,228.65C208.159,228.65,213.58,223.224,213.58,216.538L213.58,172.544C213.58,165.854,208.159,160.432,201.469,160.432z" />

            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="IconApplicationEnd">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#D32F2F">
                <!--  Roter Warn-/Stopp-Farbton  -->
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <!--  Der Kreis mit der Öffnung  -->
                        <PathGeometry Figures="M 12,2 A 10,10 0 1,1 11.9,2 Z" FillRule="EvenOdd" />
                        <!--  Der Pfeil, der nach oben/außen zeigt  -->
                        <PathGeometry Figures="M 12,5 L 12,13 M 9,8 L 12,5 L 15,8" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
                <GeometryDrawing.Pen>
                    <Pen
                        Brush="White"
                        EndLineCap="Round"
                        LineJoin="Round"
                        StartLineCap="Round"
                        Thickness="2" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="ApplicationSettingsIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#333333">
                    <GeometryDrawing.Geometry>
                        <!--  Zahnrad-Geometrie  -->
                        <GeometryGroup>
                            <!--  Äußerer Kreis und Zahnrad-Zähne  -->
                            <PathGeometry Figures="M 12,0 L 14,0 L 14.5,2.1 C 15.6,2.5 16.7,3.1 17.6,3.8 L 19.5,2.7 L 20.9,4.1 L 19.8,6.0 C 20.6,6.9 21.2,8.0 21.6,9.1 L 23.8,9.6 L 23.8,11.6 L 21.7,12.1 C 21.3,13.2 20.7,14.3 19.8,15.1 L 20.9,17.0 L 19.5,18.4 L 17.6,17.3 C 16.7,18.0 15.6,18.6 14.5,19.0 L 14.0,21.1 L 12.0,21.1 L 11.5,19.0 C 10.4,18.6 9.3,18.0 8.4,17.3 L 6.5,18.4 L 5.1,17.0 L 6.2,15.1 C 5.3,14.2 4.7,13.1 4.3,12.0 L 2.2,11.5 L 2.2,9.5 L 4.3,9.0 C 4.7,7.9 5.3,6.8 6.2,5.9 L 5.1,4.0 L 6.5,2.6 L 8.4,3.7 C 9.3,3.0 10.4,2.4 11.5,2.0 L 12.0,0 Z M 12.0,5.6 C 8.5,5.6 5.6,8.5 5.6,12.0 C 5.6,15.5 8.5,18.4 12.0,18.4 C 15.5,18.4 18.4,15.5 18.4,12.0 C 18.4,8.5 15.5,5.6 12.0,5.6 Z" />
                            <!--  Innerer Lochkreis  -->
                            <EllipseGeometry
                                Center="12,12"
                                RadiusX="3.5"
                                RadiusY="3.5" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="IconApplicationInformation">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!--  Kreis-Hintergrund  -->
                <GeometryDrawing Brush="#FF2196F3">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry
                            Center="24,24"
                            RadiusX="20"
                            RadiusY="20" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!--  I-Punkt (Kreis)  -->
                <GeometryDrawing Brush="#FFFFFFFF">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry
                            Center="24,14"
                            RadiusX="2.5"
                            RadiusY="2.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!--  I-Strich (Rechteck)  -->
                <GeometryDrawing Brush="#FFFFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry
                            RadiusX="1"
                            RadiusY="1"
                            Rect="21.5,20 5,14" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--#endregion Farbige Icon Symbole auf Basis von DrawingImage-->

</ResourceDictionary>